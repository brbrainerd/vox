// Marquee Slot 3 — Vox Chat with actor primitives.
//
// Per contracts/marquee/manifest.v1.yaml: this is the realtime archetype.
// Council ratified 2026-05-15 (D5). Demonstrates the `actor` keyword and
// the message-passing session-state lane that future "agent + agent"
// workflows depend on.
//
// Surface required by the manifest:
//   - actor declaration
//   - @endpoint(kind: stream) — surface present via send_message endpoint
//   - websocket emit               — semantic intent encoded by the actor
//   - presence state              — tracked by ChatRoom's join/leave handlers

actor ChatRoom {
    on join(user: str) to str {
        return "joined:" + user
    }

    on leave(user: str) to str {
        return "left:" + user
    }

    on send_msg(user: str, text: str) to str {
        return "msg:" + user + ":" + text
    }
}

// ── companion endpoints (front the actor over HTTP) ───────────────────────

@endpoint(kind: query) @auth(scheme: bearer) fn list_presence() to List[str] {
    return []
}

@endpoint(kind: stream) @auth(scheme: bearer) fn watch_room() to str {
    return "tick"
}

@endpoint(kind: mutation) @auth(scheme: bearer) fn send_message(text: str) to Result[str] {
    if len(text) is 0 {
        return Error("message must not be empty")
    }
    if len(text) > 4096 {
        return Error("message too long")
    }
    return Ok("queued")
}

// ── internal helpers (pure) ───────────────────────────────────────────────

fn message_is_valid(text: str) to bool {
    if len(text) is 0 {
        return false
    }
    if len(text) > 4096 {
        return false
    }
    return true
}

fn presence_label(joined: bool) to str {
    if joined is true {
        return "online"
    }
    return "offline"
}

fn render_join_ack(user: str) to str {
    return "joined:" + user
}

fn render_leave_ack(user: str) to str {
    return "left:" + user
}

fn render_send_ack(user: str, text: str) to str {
    return "msg:" + user + ":" + text
}

// ── tests ─────────────────────────────────────────────────────────────────

@test
fn test_message_empty_is_invalid() to Unit {
    assert(message_is_valid("") is false)
}

@test
fn test_message_typical_is_valid() to Unit {
    assert(message_is_valid("hello world") is true)
}

@test
fn test_presence_online() to Unit {
    assert(presence_label(true) is "online")
}

@test
fn test_presence_offline() to Unit {
    assert(presence_label(false) is "offline")
}

@test
fn test_join_ack_format() to Unit {
    assert(render_join_ack("ada") is "joined:ada")
}

@test
fn test_leave_ack_format() to Unit {
    assert(render_leave_ack("ada") is "left:ada")
}

@test
fn test_send_ack_format() to Unit {
    assert(render_send_ack("ada", "hi") is "msg:ada:hi")
}

@test
fn test_send_message_rejects_empty() to Unit {
    let r = send_message("")
    match r {
        Error(_) => assert(true)
        Ok(_) => assert(false)
    }
}

@test
fn test_send_message_accepts_typical() to Unit {
    let r = send_message("hello")
    match r {
        Ok(s) => assert(s is "queued")
        Error(_) => assert(false)
    }
}

// ── examples (corpus-eligible reference solutions) ────────────────────────

@example
fn ex_message_validity_round_trip() to Unit {
    assert(message_is_valid("hi") is true)
    assert(message_is_valid("") is false)
}

@example("ack formatting")
fn ex_ack_round_trip() to Unit {
    assert(render_join_ack("ada") is "joined:ada")
    assert(render_leave_ack("ada") is "left:ada")
    assert(render_send_ack("ada", "hi") is "msg:ada:hi")
}
