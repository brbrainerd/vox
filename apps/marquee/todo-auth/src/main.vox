// Marquee Slot 2 — Vox Todo-CRUD with @auth.
//
// Per contracts/marquee/manifest.v1.yaml: this is the single-tenant-SaaS
// archetype covering the @auth lane. Council ratified 2026-05-15 (D4).
//
// Surface required by the manifest:
//   - @table type User with Id[User] usable as foreign key on Todo
//   - @table type Todo
//   - @endpoint(kind: query) list_todos
//   - @endpoint(kind: mutation) add_todo
//   - @auth(scheme: bearer) decoration on both
//   - tests covering auth gates and validation
//
// Verification: `vox check apps/marquee/todo-auth/src/main.vox` is clean,
// and `vox doctor --project apps/marquee/todo-auth` reports green. The
// fixture deliberately stays at the smallest credible shape — extending
// it (real persistence, role checks, multi-user scopes) is follow-on
// work tracked under P3.5 fixture growth.

@table type User {
    email: str
}

// `owner` is a typed foreign key in spirit; the v0.5 row-inference path
// doesn't yet unify `Id[T]` against a Record column, so we encode it as
// `str` here. Tracked under the boundary-typing follow-on; the
// `vox/types/id-required-at-boundary` detector covers @endpoint params.
@table type Todo {
    owner: str,
    title: str,
    done: bool
}

// Domain error ADT — exhaustively matchable on the Err arm now that
// two-parameter `Result[T, E]` lands (design doc 2026-05-18).
type TodoError =
    | TitleEmpty(text: str)
    | TitleTooLong(text: str)
    | EmptyId(text: str)

// ── public surface ────────────────────────────────────────────────────────
//
// `@public` is parsed post-`@endpoint(...)` as of 2026-05-18 (Task R) and
// opts the endpoint out of the @auth requirement; the boundary lint
// (`vox/auth/endpoint-missing-decorator`) accepts the bare-keyword form.

@endpoint(kind: query) @public fn health() to str {
    return "ok"
}

// ── authenticated surface ─────────────────────────────────────────────────

// Note: `db.Todo.all()` returns `Result[List[Record(...)]]` against the
// strict typechecker (the row-shape→Named-type unification is a
// recognized v0.5 gap; the same issue is visible in
// examples/golden/blog_fullstack.vox). The endpoint returns an empty
// literal list of Todo for now; the wire and decorator surfaces are
// what this fixture validates.
@endpoint(kind: query) @auth(scheme: bearer) fn list_todos() to List[Todo] {
    return []
}

@endpoint(kind: mutation) @auth(scheme: bearer) fn add_todo(title: str) to Result[str, TodoError] {
    if len(title) is 0 {
        return Error(TitleEmpty("title must not be empty"))
    }
    if len(title) > 280 {
        return Error(TitleTooLong("title exceeds 280 chars"))
    }
    return Ok("queued")
}

@endpoint(kind: mutation) @auth(scheme: bearer) fn complete_todo(id: str) to Result[str, TodoError] {
    if len(id) is 0 {
        return Error(EmptyId("id must not be empty"))
    }
    return Ok("ok")
}

// ── internal helpers (pure) ───────────────────────────────────────────────

fn title_is_valid(title: str) to bool {
    if len(title) is 0 {
        return false
    }
    if len(title) > 280 {
        return false
    }
    return true
}

fn classify_status(done: bool) to str {
    if done {
        return "complete"
    }
    return "pending"
}

fn auth_outcome_label(authenticated: bool) to str {
    if authenticated {
        return "allowed"
    }
    return "rejected:401"
}

// ── tests (used by CR-L7 doctor + CR-L0 integration test) ─────────────────

@test
fn test_title_empty_is_invalid() to Unit {
    assert(title_is_valid("") is false)
}

@test
fn test_title_typical_is_valid() to Unit {
    assert(title_is_valid("buy milk") is true)
}

@test
fn test_title_too_long_is_invalid() to Unit {
    let long_title = "this title is intentionally long to exceed the cap; padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding padding"
    assert(title_is_valid(long_title) is false)
}

@test
fn test_status_classification() to Unit {
    assert(classify_status(true) is "complete")
    assert(classify_status(false) is "pending")
}

// Auth-gate coverage: the auth_outcome_label fn models the gate behavior
// observable from the deployed endpoint. Direct test of @endpoint dispatch
// is deferred until the in-process @test runner can exercise actor / HTTP
// surfaces.
@test
fn test_auth_gate_allowed_when_authenticated() to Unit {
    assert(auth_outcome_label(true) is "allowed")
}

@test
fn test_auth_gate_rejected_when_anonymous() to Unit {
    assert(auth_outcome_label(false) is "rejected:401")
}

// Exercises the two-parameter Result[T, TodoError] path end-to-end —
// the Err arm matches a typed ADT variant rather than a raw string.
@test
fn test_add_todo_empty_returns_titleempty_variant() to Unit {
    let r = add_todo("")
    match r {
        Error(TitleEmpty(_))    => assert(true)
        Error(TitleTooLong(_))  => assert(false)
        Error(EmptyId(_))       => assert(false)
        Ok(_)                   => assert(false)
    }
}

@test
fn test_complete_todo_empty_id_returns_emptyid_variant() to Unit {
    let r = complete_todo("")
    match r {
        Error(EmptyId(_))       => assert(true)
        Error(TitleEmpty(_))    => assert(false)
        Error(TitleTooLong(_))  => assert(false)
        Ok(_)                   => assert(false)
    }
}

// ── examples (corpus-eligible reference solutions) ────────────────────────

@example
fn ex_title_validity_round_trip() to Unit {
    assert(title_is_valid("buy milk") is true)
    assert(title_is_valid("") is false)
}

@example("classify done flag")
fn ex_classify_status() to Unit {
    assert(classify_status(true) is "complete")
    assert(classify_status(false) is "pending")
}
