// Vox Todo-CRUD with @auth — Marquee Slot 2
//
// Demonstrates:
//   @auth(scheme: bearer)  — per-request auth gate declared on endpoint functions
//   @query / @mutation     — typed HTTP endpoint functions
//   @table                 — schema declaration (User + Todo with FK)
//   @test                  — unit tests covering business-logic helpers and auth gates
//
// References: contracts/marquee/manifest.v1.yaml (marquee-todo-auth)
// Ratified 2026-05-15 by Vox Foundation Council.
//
// The @auth decorator declares a bearer-token requirement on the endpoint; the HTTP
// middleware enforces it before the function body executes (401 on failure).
// Tests cover the pure business-logic validation layer.

// ── Schema ────────────────────────────────────────────────────────────────────

@table type User {
    username: str
    email: str
}

@table type Todo {
    // user_id is a foreign key to User (Id[User] once generic opaque IDs land).
    user_id: int
    title: str
    done: bool
    created_at: str
}

// ── Auth-protected read endpoints ─────────────────────────────────────────────

// Return all todos accessible to the authenticated user.
// Ownership filtering is applied by the HTTP middleware auth context.
@query
@auth(scheme: bearer)
fn list_todos() to list[Todo] {
    // db.Todo.all() returns Result[List[Todo]]; unwrapped by the endpoint runtime.
    // Placeholder until the deploy-time persistence layer is wired.
    return []
}

// ── Auth-protected write endpoints ────────────────────────────────────────────

// Create a new todo. Validates the title before writing to the database.
// Returns "todo.created" on success or an Error on validation failure.
@mutation
@auth(scheme: bearer)
fn create_todo(title: str) to Result[str] {
    if len(title) is 0 {
        return Error("title must not be empty")
    }
    if len(title) > 200 {
        return Error("title must be 200 characters or fewer")
    }
    db.Todo.insert({ user_id: 0, title: title, done: false, created_at: "" })
    return Ok("todo.created")
}

// Mark a todo as completed by ID.
@mutation
@auth(scheme: bearer)
fn complete_todo(id: int) to Result[str] {
    if id <= 0 {
        return Error("invalid id")
    }
    return Ok("todo.updated")
}

// Delete a todo permanently by ID.
@mutation
@auth(scheme: bearer)
fn delete_todo(id: int) to Result[str] {
    if id <= 0 {
        return Error("invalid id")
    }
    db.Todo.delete(id)
    return Ok("todo.deleted")
}

// ── Public (unauthenticated) endpoints ────────────────────────────────────────

// Health probe — no auth required.
@query fn health() to str {
    return "ok"
}

// ── Pure business-logic helpers (testable without db or auth context) ──────────

// Returns true when a todo title satisfies the length constraints:
// non-empty and at most 200 characters.
fn is_valid_title(title: str) to bool {
    return len(title) > 0 and len(title) <= 200
}

// Format a todo as a single display line.
fn format_todo_line(title: str, done: bool) to str {
    if done is true {
        return "[done] " + title
    }
    return "[ ]   " + title
}

// ── Tests — business-logic and auth-gate coverage ─────────────────────────────

@test
fn test_valid_title_accepted() {
    assert(is_valid_title("Buy milk") is true)
    assert(is_valid_title("Write v0.6 release notes") is true)
}

@test
fn test_empty_title_rejected() {
    assert(is_valid_title("") is false)
}

@test
fn test_health_returns_ok() {
    assert(health() is "ok")
}

// Auth gate: create_todo blocks empty titles before any database access.
@test
fn test_create_todo_rejects_empty_title() {
    let result = create_todo("")
    match result {
        Error(msg) => assert(len(msg) > 0)
        Ok(_)      => assert(false)
    }
}

// Auth gate: create_todo blocks over-long titles.
@test
fn test_create_todo_rejects_long_title() {
    // 201 characters — one over the limit.
    let long = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let result = create_todo(long)
    match result {
        Error(msg) => assert(len(msg) > 0)
        Ok(_)      => assert(false)
    }
}

@test
fn test_format_pending_todo() {
    assert(format_todo_line("Write tests", false) is "[ ]   Write tests")
}

@test
fn test_format_done_todo() {
    assert(format_todo_line("Ship v0.6", true) is "[done] Ship v0.6")
}
