// vox-mental-tracker — append-only HealthEventLog SSOT, exports (see src/ts/export_contract.ts for row projection), on-device STT via Tauri 2.
import std.mobile

/// Structured parser output. Mirrors apps/vox-mental-tracker/src/ts/intent_parser.ts.
type ParsedVoice {
    kind: str,
    payload_json: str,
    confidence: float,
}

@table type HealthEventLog {
    event_id: str
    event_kind: str
    schema_version: int
    payload_json: str
    event_at: str
    recorded_at: str
    recorded_at_monotonic: int
    tz_iana: str
    tz_offset_minutes: int
    source: str
    raw_transcript_id: str
    correction_of: str
}

@table type RawTranscript {
    transcript_id: str
    captured_at: str
    transcript_text: str
    parser_decisions_json: str
    confidence: float
}

@query fn health_event_count() to int {
    match db.HealthEventLog.all() {
        Ok(rows) => len(rows)
        Error(_) => 0
    }
}

@mutation fn record_health_event(event_kind: str, payload_json: str, event_at: str, source: str, raw_transcript_id: str, correction_of: str, tz_iana: str, tz_offset_minutes: int) to Result[str] {
    let eid = std.crypto.uuid()
    let rec_ms = std.time.now_ms()
    db.HealthEventLog.insert({
        event_id: eid,
        event_kind: event_kind,
        schema_version: 1,
        payload_json: payload_json,
        event_at: event_at,
        recorded_at: str(rec_ms),
        recorded_at_monotonic: rec_ms,
        tz_iana: tz_iana,
        tz_offset_minutes: tz_offset_minutes,
        source: source,
        raw_transcript_id: raw_transcript_id,
        correction_of: correction_of,
    })?
    return Ok(eid)
}

@mutation fn record_event(event_kind: str, payload_json: str, event_at: str, source: str, raw_transcript_id: str, correction_of: str, tz_iana: str, tz_offset_minutes: int) to Result[str] {
    return record_health_event(event_kind, payload_json, event_at, source, raw_transcript_id, correction_of, tz_iana, tz_offset_minutes)
}

@mutation fn record_correction(of_event_id: str, event_kind: str, payload_json: str, event_at: str, source: str, tz_iana: str, tz_offset_minutes: int) to Result[str] {
    return record_health_event(event_kind, payload_json, event_at, source, "", of_event_id, tz_iana, tz_offset_minutes)
}

/// Append-only delete: tombstone the row `of_event_id` by recording a `_deleted`
/// sentinel whose `correction_of` points at it. The materializer collapses the
/// pair — the target is superseded and the tombstone is kind-hidden — so the
/// event disappears from the timeline, weekly rollup, and clinical export
/// without ever mutating or removing a physical row (db.Delete is unsupported
/// on-device). Returns the tombstone's own event id.
@mutation fn record_deletion(of_event_id: str, tz_iana: str, tz_offset_minutes: int) to Result[str] {
    return record_health_event("_deleted", "{}", "", "app", "", of_event_id, tz_iana, tz_offset_minutes)
}

@mutation fn record_raw_transcript(transcript_text: str, parser_decisions_json: str, confidence: float) to Result[str] {
    let tid = std.crypto.uuid()
    let ms = std.time.now_ms()
    db.RawTranscript.insert({
        transcript_id: tid,
        captured_at: str(ms),
        transcript_text: transcript_text,
        parser_decisions_json: parser_decisions_json,
        confidence: confidence,
    })?
    return Ok(tid)
}

/// Best-effort string-to-int. Uses std.json.parse for digit-string coercion;
/// returns the supplied default on any parse failure.
fn _parse_int_default(s: str, default_value: int) to int {
    return match std.json.parse("{\"v\":" + s + "}") {
        Ok(j) => j.get("v").and_then(fn(x: Json) to Option[int] { x.as_int() }).unwrap_or(default_value)
        Error(_) => default_value
    }
}

/// Clamp `n` into [lo, hi].
fn _clamp(n: int, lo: int, hi: int) to int {
    if n < lo { return lo }
    if n > hi { return hi }
    return n
}

/// True when the event was recorded more than 5 min after it occurred.
/// Ported from export_contract.ts `isBackdated` (§3.B).
fn _is_backdated(event_at_ms: str, recorded_at_ms: str) to bool {
    let ea = _parse_int_default(event_at_ms, 0)
    let ra = _parse_int_default(recorded_at_ms, 0)
    if ea is 0 { return false }
    return (ra - ea) > 300000
}

/// CSV-quote a field: wrap in double-quotes, escape inner quotes.
/// Ported from export_contract.ts `csvQuote` (§3.B).
fn _csv_quote(s: str) to str {
    return "\"" + s.replace("\"", "\"\"") + "\""
}

/// True when `check_id` appears as the `correction_of` of any row.
/// O(n) scan; used inside the O(n²) effective-events pass (§3.A).
fn _is_superseded_in(check_id: str, rows: List[HealthEventLog]) to bool {
    let mut found = false
    for r in rows {
        if r.correction_of == check_id { found = true }
    }
    return found
}

/// Sentinel `event_kind` written by `record_deletion` to tombstone a prior row.
/// A tombstone supersedes its target (its `correction_of` points at the target,
/// so the target fails `_is_effective`) AND is itself hidden — nothing references
/// the tombstone's own id, so without this kind-check it would leak into the
/// timeline / rollup / export as a bare "_deleted" row.
fn _is_effective(r: HealthEventLog, rows: List[HealthEventLog]) to bool {
    return r.event_kind != "_deleted" and not _is_superseded_in(r.event_id, rows)
}

/// In-memory HealthEventLog value for unit tests (no db insert). Defaults the
/// non-salient fields so each test only states the id / kind / correction_of
/// that the assertion turns on.
fn _mk_test_event(event_id: str, event_kind: str, correction_of: str) to HealthEventLog {
    return {
        event_id: event_id,
        event_kind: event_kind,
        schema_version: 1,
        payload_json: "{}",
        event_at: "0",
        recorded_at: "0",
        recorded_at_monotonic: 0,
        tz_iana: "UTC",
        tz_offset_minutes: 0,
        source: "test",
        raw_transcript_id: "",
        correction_of: correction_of,
    }
}

@test
fn test_effective_plain_event_is_visible() to Unit {
    let e = _mk_test_event("e1", "mood_recorded", "")
    let rows = [e]
    assert(_is_effective(e, rows))
}

@test
fn test_effective_deletion_hides_target_and_tombstone() to Unit {
    let target = _mk_test_event("e1", "mood_recorded", "")
    let tomb = _mk_test_event("t1", "_deleted", "e1")
    let rows = [target, tomb]
    // Target is superseded by the tombstone → hidden.
    assert(not _is_effective(target, rows))
    // Tombstone itself is hidden by its sentinel kind → never leaks into views.
    assert(not _is_effective(tomb, rows))
}

@test
fn test_effective_correction_supersedes_original_but_stays_visible() to Unit {
    let original = _mk_test_event("e1", "mood_recorded", "")
    let correction = _mk_test_event("e2", "mood_recorded", "e1")
    let rows = [original, correction]
    assert(not _is_effective(original, rows))
    assert(_is_effective(correction, rows))
}

@test
fn test_is_backdated_over_threshold() to Unit {
    assert(_is_backdated("1000000", "1301000"))
}

@test
fn test_is_backdated_under_threshold() to Unit {
    assert(not _is_backdated("1000000", "1299999"))
}

@test
fn test_is_backdated_zero_event_at() to Unit {
    assert(not _is_backdated("0", "999999"))
}

@test
fn test_csv_quote_plain() to Unit {
    assert(_csv_quote("hello") is "\"hello\"")
}

@test
fn test_csv_quote_inner_quotes() to Unit {
    assert(_csv_quote("say \"hi\"") is "\"say \"\"hi\"\"\"")
}

/// Authoritative voice classifier (mirrors src/ts/intent_parser.ts). Returns a
/// structured ParsedVoice; the UI / save flow pulls each field directly.
@query fn parse_voice(transcript: str) to ParsedVoice {
    let t = transcript.trim().to_lower()

    // Mood: "I feel like a 3" / "mood is 4"
    let mood_re = std.regex.compile("(?:mood|feeling).*?(\\d)")
    match mood_re {
        Ok(re) => match re.find(t) {
            Some(m) => match m.group(1) {
                Some(d) => {
                    let raw = _parse_int_default(d, 3)
                    let score = _clamp(raw, 1, 5)
                    return { kind: "mood_recorded", payload_json: "{\"mood_score\":" + str(score) + "}", confidence: 0.75 }
                }
                None => "fallthrough"
            }
            None => "fallthrough"
        }
        Error(_) => "fallthrough"
    }

    // Exercise: "ran 30 min", "walked for 15 minutes"
    let ex_re = std.regex.compile("(?:ran|run|jogged|walked)\\s+(?:for\\s+)?(\\d+)\\s*(?:min|minutes)")
    match ex_re {
        Ok(re) => match re.find(t) {
            Some(m) => match m.group(1) {
                Some(d) => {
                    let mins = _parse_int_default(d, 0)
                    return { kind: "exercise_recorded", payload_json: "{\"activity\":\"cardio\",\"duration_minutes\":" + str(mins) + "}", confidence: 0.7 }
                }
                None => "fallthrough"
            }
            None => "fallthrough"
        }
        Error(_) => "fallthrough"
    }

    // Meal: "ate X" / "had X" / "eating X" — capture the rest of the line
    let meal_re = std.regex.compile("(?:ate|eating|had)\\s+(.+)")
    match meal_re {
        Ok(re) => match re.find(t) {
            Some(m) => match m.group(1) {
                Some(desc_raw) => {
                    let desc = desc_raw.trim().replace("\"", "'")
                    return { kind: "meal_recorded", payload_json: "{\"description\":\"" + desc + "\"}", confidence: 0.65 }
                }
                None => "fallthrough"
            }
            None => "fallthrough"
        }
        Error(_) => "fallthrough"
    }

    // Sleep: bed / sleep / slept / nap (substring check is sufficient)
    if t.contains("bed") or t.contains("sleep") or t.contains("slept") or t.contains("nap") {
        return { kind: "sleep_started", payload_json: "{}", confidence: 0.55 }
    }

    // Default — preserve the whole utterance as a note.
    let body = transcript.replace("\"", "'")
    return { kind: "note_recorded", payload_json: "{\"body\":\"" + body + "\"}", confidence: 0.4 }
}

/// Backward-compatible string facade over parse_voice. Kept so older UI /
/// fixture consumers don't break; new code should call parse_voice directly.
@query fn preview_voice_parse(transcript: str) to str {
    let p = parse_voice(transcript)
    return "{\"kind\":\"" + p.kind + "\",\"payload\":" + p.payload_json + ",\"confidence\":" + str(p.confidence) + "}"
}

/// Per-kind weekly rollup over effective (non-superseded) events.
/// Ported correction-chain collapse from src/ts/materializer.ts (§3.A).
@query fn weekly_summary_json() to str {
    match db.HealthEventLog.all() {
        Ok(rows) => {
            let mut total = 0
            let mut moods = 0
            let mut meals = 0
            let mut sleep_starts = 0
            let mut sleep_ends = 0
            let mut exercises = 0
            let mut notes = 0
            for r in rows {
                if _is_effective(r, rows) {
                    total = total + 1
                    if r.event_kind == "mood_recorded" { moods = moods + 1 }
                    if r.event_kind == "meal_recorded" { meals = meals + 1 }
                    if r.event_kind == "sleep_started" { sleep_starts = sleep_starts + 1 }
                    if r.event_kind == "sleep_ended" { sleep_ends = sleep_ends + 1 }
                    if r.event_kind == "exercise_recorded" { exercises = exercises + 1 }
                    if r.event_kind == "note_recorded" { notes = notes + 1 }
                }
            }
            let result = "{\"window_days\":7,\"total_events\":" + str(total) + ",\"per_kind\":{\"mood_recorded\":" + str(moods) + ",\"meal_recorded\":" + str(meals) + ",\"sleep_started\":" + str(sleep_starts) + ",\"sleep_ended\":" + str(sleep_ends) + ",\"exercise_recorded\":" + str(exercises) + ",\"note_recorded\":" + str(notes) + "}}"
            result
        }
        Error(_) => "{\"error\":\"db\"}"
    }
}

/// Effective HealthEventLog rows as JSON — superseded rows excluded, is_backdated included.
/// Replaces the TS materializer client-side pass (§3.A); payload_json is JSON-escaped.
@query fn timeline_events_json() to str {
    match db.HealthEventLog.all() {
        Ok(rows) => {
            let mut out = "["
            let mut first = true
            for r in rows {
                if _is_effective(r, rows) {
                    if first { first = false } else { out = out + "," }
                    let backdated = _is_backdated(r.event_at, r.recorded_at)
                    let pj = r.payload_json.replace("\\", "\\\\").replace("\"", "\\\"")
                    let chunk = "{\"event_id\":\"" + r.event_id + "\",\"event_kind\":\"" + r.event_kind + "\",\"schema_version\":" + str(r.schema_version) + ",\"payload_json\":\"" + pj + "\",\"event_at\":\"" + r.event_at + "\",\"recorded_at\":\"" + r.recorded_at + "\",\"recorded_at_monotonic\":" + str(r.recorded_at_monotonic) + ",\"tz_iana\":\"" + r.tz_iana + "\",\"tz_offset_minutes\":" + str(r.tz_offset_minutes) + ",\"source\":\"" + r.source + "\",\"raw_transcript_id\":\"" + r.raw_transcript_id + "\",\"correction_of\":\"" + r.correction_of + "\",\"is_backdated\":" + str(backdated) + "}"
                    out = out + chunk
                }
            }
            let result = out + "]"
            result
        }
        Error(_) => "[]"
    }
}

/// Human-readable list of effective (non-superseded) events, one per line:
/// "• <kind> — <payload_json>". Empty-state friendly. Renders in TimelinePage
/// via the proven query-string → text(mh-list) pattern (cf. weekly_summary_json).
@query fn timeline_lines() to str {
    match db.HealthEventLog.all() {
        Ok(rows) => {
            let mut out = ""
            let mut shown = 0
            for r in rows {
                if _is_effective(r, rows) {
                    shown = shown + 1
                    out = out + "• " + r.event_kind + " — " + r.payload_json + "\n"
                }
            }
            if shown is 0 { return "No events yet. Add one from Home or Voice." }
            out
        }
        Error(_) => "Could not read the event log."
    }
}

/// Full CSV export — header + one row per effective (non-superseded) event.
/// Ported from export_contract.ts `buildHealthCsv` (§3.B).
@query fn export_health_csv() to str {
    let header = "event_id,event_kind,schema_version,payload_json,event_at,recorded_at,recorded_at_monotonic,tz_iana,tz_offset_minutes,source,raw_transcript_id,correction_of,is_backdated"
    match db.HealthEventLog.all() {
        Ok(rows) => {
            let mut out = header
            for r in rows {
                if _is_effective(r, rows) {
                    let backdated = _is_backdated(r.event_at, r.recorded_at)
                    let mut row = _csv_quote(r.event_id) + "," + _csv_quote(r.event_kind) + "," + str(r.schema_version)
                    row = row + "," + _csv_quote(r.payload_json) + "," + _csv_quote(r.event_at) + "," + _csv_quote(r.recorded_at)
                    row = row + "," + str(r.recorded_at_monotonic) + "," + _csv_quote(r.tz_iana) + "," + str(r.tz_offset_minutes)
                    row = row + "," + _csv_quote(r.source) + "," + _csv_quote(r.raw_transcript_id) + "," + _csv_quote(r.correction_of)
                    row = row + "," + _csv_quote(str(backdated))
                    out = out + "\n" + row
                }
            }
            out
        }
        Error(_) => header
    }
}

/// JSON bundle metadata with content SHA-256 of the full CSV export (§3.B).
@query fn export_health_json_bundle() to str {
    let csv_payload = export_health_csv()
    let hash = std.crypto.hash_secure(csv_payload)
    match db.HealthEventLog.all() {
        Ok(rows) => {
            // row_count tracks the EFFECTIVE rows in the CSV the hash is taken
            // over — exclude tombstones + superseded rows so metadata matches.
            let mut eff = 0
            for r in rows {
                if _is_effective(r, rows) { eff = eff + 1 }
            }
            "{\"schema\":\"vox.mental_tracker.export_bundle\",\"version\":1,\"generated_ms\":" + str(std.time.now_ms()) + ",\"content_sha256\":\"" + hash + "\",\"row_count\":" + str(eff) + "}"
        }
        Error(_) => "{\"error\":\"db\"}"
    }
}

/// Clinician-shareable HTML report — full CSV + weekly summary (§3.C).
@query fn export_clinical_html() to str {
    let summary = weekly_summary_json()
    let csv_payload = export_health_csv()
    let hash = std.crypto.hash_secure(csv_payload)
    let lbrace = "{"
    let rbrace = "}"
    let css = "body" + lbrace + "font-family:system-ui;margin:24px;" + rbrace + "pre" + lbrace + "white-space:pre-wrap;overflow-x:auto;font-size:12px;" + rbrace
    let mut body = "<!doctype html><html><head><meta charset=\"utf-8\"/><title>Mental Health Tracker — clinical export</title><style>" + css + "</style></head><body>"
    body = body + "<h1>Clinical export</h1><p>Generated (UTC ms): " + str(std.time.now_ms()) + "</p><p>Content SHA-256: <code>" + hash + "</code></p>"
    body = body + "<h2>Weekly summary</h2><pre>" + summary + "</pre>"
    body = body + "<h2>Methodology</h2><p>Append-only event log. Rows whose <code>correction_of</code> references a prior row supersede that row. <code>is_backdated</code> is set when <code>recorded_at − event_at &gt; 5 min</code>.</p>"
    body = body + "<h2>CSV export</h2><pre>" + csv_payload + "</pre>"
    body = body + "</body></html>"
    return body
}

@server fn health() to Result[str] {
    return Ok("ok")
}

@mutation fn save_mood(score: int, note: str) to Result[str] {
    let payload = "{\"mood_score\":" + str(score) + ",\"note\":\"" + note.replace("\"", "'") + "\"}"
    return record_health_event(
        "mood_recorded", payload, str(std.time.now_ms()), "form", "", "", "UTC", 0
    )
}

@form Mood {
    field score: int range(1..10) required label("How are you feeling? (1–10)")
    field note: str max_len(280) optional label("Anything to share?")
    on_submit: save_mood
    success_redirect: "/timeline"
    error_message: "Couldn't save mood. Try again."
}

/// Routable page wrapping the `Mood` @form (forms can't be route targets
/// directly — a route needs a component with a view root).
component MoodPage() {
    view: column(raw_class="mh-root") {
        NavBar()
        heading(level=2) { "Log your mood" }
        Mood()
    }
}

component NavBar() {
    view: row(raw_class="mh-nav") {
        link(href="/") { "Home" }
        text(raw_class="mh-nav-dot") { " · " }
        link(href="/timeline") { "Timeline" }
        text(raw_class="mh-nav-dot") { " · " }
        link(href="/weekly") { "Weekly" }
        text(raw_class="mh-nav-dot") { " · " }
        link(href="/export") { "Export" }
        text(raw_class="mh-nav-dot") { " · " }
        link(href="/voice") { "Voice" }
        text(raw_class="mh-nav-dot") { " · " }
        link(href="/settings") { "Settings" }
    }
}

component Home() {
    state saved: int = 0
    view: column(raw_class="mh-root") {
        NavBar()
        heading(level=1) { "Mental Health Tracker" }
        text(raw_class="mh-sub") { "Local-first • append-only log • corrections via record_correction • on-device STT via Tauri 2 plugin" }
        row(raw_class="mh-actions") {
            button(on_click={fn() {
                let ms = std.time.now_ms()
                let _ = record_event("mood_recorded", "{\"mood_score\":3}", str(ms), "manual", "", "", "UTC", 0)
                saved = saved + 1
            }}) {
                "Mood 3"
            }
            button(on_click={fn() {
                let ms = std.time.now_ms()
                let _ = record_event("meal_recorded", "{\"description\":\"snack\",\"meal_type\":\"snack\"}", str(ms), "manual", "", "", "UTC", 0)
                saved = saved + 1
            }}) {
                "Snack"
            }
            button(on_click={fn() {
                let ms = std.time.now_ms()
                let _ = record_event("sleep_started", "{}", str(ms), "manual", "", "", "UTC", 0)
                saved = saved + 1
            }}) {
                "Sleep start"
            }
            button(on_click={fn() {
                let ms = std.time.now_ms()
                let _ = record_event("sleep_ended", "{}", str(ms), "manual", "", "", "UTC", 0)
                saved = saved + 1
            }}) {
                "Sleep end"
            }
            button(on_click={fn() {
                let ms = std.time.now_ms()
                let _ = record_event("exercise_recorded", "{\"activity\":\"walk\",\"duration_minutes\":15}", str(ms), "manual", "", "", "UTC", 0)
                saved = saved + 1
            }}) {
                "Exercise 15m"
            }
        }
        text(raw_class="mh-count") { "Quick-add taps (session): " + str(saved) }
        button(on_click={fn() {
            match Speech.transcribe_microphone() {
                Ok(t) => {
                    let _ = mobile.notify("Transcript", t)
                }
                Error(e) => {
                    let _ = mobile.notify("STT", e)
                }
            }
        }}) {
            "Try on-device STT"
        }
    }
}

component TimelinePage() {
    state total: int = 0
    state lines: str = ""
    on mount: {
        total = health_event_count()
        lines = timeline_lines()
    }
    view: column(raw_class="mh-root") {
        NavBar()
        heading(level=2) { "Timeline" }
        text(raw_class="mh-sub") { str(total) + " events recorded · superseded & deleted rows hidden" }
        text(raw_class="mh-list") { lines }
        link(href="/export") { "Export CSV / clinical HTML →" }
    }
}

component WeeklyPage() {
    state blob: str = "{}"
    on mount: {
        blob = weekly_summary_json()
    }
    view: column(raw_class="mh-root") {
        NavBar()
        heading(level=2) { "Weekly summary" }
        text(raw_class="mh-pre") { blob }
        link(href="/") { "← Home" }
    }
}

component ExportPage() {
    state csv: str = ""
    state html: str = ""
    on mount: {
        csv = export_health_csv()
        html = export_clinical_html()
    }
    view: column(raw_class="mh-root") {
        NavBar()
        heading(level=2) { "Exports" }
        text(raw_class="mh-sub") { "CSV header + clinical HTML (see apps/docs for full row export via TS contract helper)." }
        text(raw_class="mh-pre") { csv }
        text(raw_class="mh-sub") { "HTML clinical length (chars): " + str(html.length()) }
        link(href="/") { "← Home" }
    }
}

component VoicePage() {
    state transcript_raw: str = ""
    state parsed_kind: str = ""
    state parsed_payload: str = ""
    state parsed_confidence: float = 0.0
    state parsed_summary: str = ""
    state last_saved_event_id: str = ""
    state status: str = "Tap Transcribe to start."
    view: column(raw_class="mh-root") {
        NavBar()
        heading(level=2) { "Voice → parse → save" }
        text(raw_class="mh-sub") { status }
        button(on_click={fn() {
            match Speech.transcribe_microphone() {
                Ok(t) => {
                    transcript_raw = t
                    parsed_kind = ""
                    parsed_payload = ""
                    parsed_confidence = 0.0
                    parsed_summary = ""
                    status = "Transcript captured — tap Parse to classify."
                }
                Error(e) => { status = "Transcribe failed: " + e }
            }
        }}) {
            "Transcribe"
        }
        button(on_click={fn() {
            let p = parse_voice(transcript_raw)
            parsed_kind = p.kind
            parsed_payload = p.payload_json
            parsed_confidence = p.confidence
            parsed_summary = preview_voice_parse(transcript_raw)
            status = "Parsed as " + p.kind + " — review the payload, then Save."
        }}) {
            "Parse"
        }
        button(on_click={fn() {
            if parsed_kind == "" {
                status = "Nothing parsed yet — tap Parse first."
            } else {
                let ms = std.time.now_ms()
                match record_raw_transcript(transcript_raw, parsed_summary, parsed_confidence) {
                    Ok(tid) => {
                        match record_event(parsed_kind, parsed_payload, str(ms), "voice", tid, "", "UTC", 0) {
                            Ok(eid) => {
                                last_saved_event_id = eid
                                status = "Saved " + parsed_kind + " (event " + eid + "). Use /timeline to view."
                            }
                            Error(e) => { status = "Event save failed: " + e }
                        }
                    }
                    Error(e) => { status = "Transcript persist failed: " + e }
                }
            }
        }}) {
            "Save"
        }
        button(on_click={fn() {
            transcript_raw = ""
            parsed_kind = ""
            parsed_payload = ""
            parsed_confidence = 0.0
            parsed_summary = ""
            last_saved_event_id = ""
            status = "Cleared. Tap Transcribe to start again."
        }}) {
            "Reset"
        }
        text(raw_class="mh-pre") { "RAW: " + transcript_raw }
        text(raw_class="mh-pre") { "KIND: " + parsed_kind }
        text(raw_class="mh-pre") { "PAYLOAD: " + parsed_payload }
        text(raw_class="mh-pre") { "CONFIDENCE: " + str(parsed_confidence) }
        text(raw_class="mh-sub") { "Last saved: " + last_saved_event_id }
        link(href="/") { "← Home" }
    }
}

@table type CrashReport {
    id: int
    error: str
    stack: str
    ts: str
    route: str
}

/// Parse a flat `{"error":..,"stack":..,"route":..}` crash payload and persist
/// it. Returns 1 on a durable write, 0 if the payload was unparseable or the
/// insert failed — callers treat any non-positive result as "not recorded".
@mutation fn record_crash_report(json: str) to int {
    match std.json.parse(json) {
        Ok(j) => {
            let err = j.get("error").and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
            let stack = j.get("stack").and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
            let route = j.get("route").and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
            match db.CrashReport.insert({
                id: 0,
                error: err,
                stack: stack,
                ts: str(std.time.now_ms()),
                route: route,
            }) {
                Ok(_) => 1
                Error(_) => 0
            }
        }
        Error(_) => 0
    }
}

@table type PushToken {
    id: int
    token: str
    registered_at: str
}

/// Persist a device push-registration token. Returns 1 on a durable write,
/// 0 if the insert failed. This is the on-device record of "this install can
/// receive notifications"; the export/clinical surfaces don't touch it.
@mutation fn store_push_token(token: str) to int {
    match db.PushToken.insert({
        id: 0,
        token: token,
        registered_at: str(std.time.now_ms()),
    }) {
        Ok(_) => 1
        Error(_) => 0
    }
}

/// Engagement/adherence log for push interactions. Kept deliberately separate
/// from HealthEventLog so it never leaks into the clinical CSV/HTML export
/// (§3.B/§3.C), while still being durable on-device data — "did the reminder
/// land, and did the user act on it" is meaningful for a mental-health tool.
@table type NotificationLog {
    id: int
    kind: str
    title: str
    body: str
    action_id: str
    payload_json: str
    occurred_at: str
}

/// `on_notification` — a push was delivered to the device. Records a
/// "received" engagement row from the `{title, body}` payload. Returns 1 on a
/// durable write, 0 on parse/insert failure.
@mutation fn handle_push_payload(json: str) to int {
    return _record_notification("received", json, "")
}

/// `on_action` — the user tapped a notification (action). Records a "tapped"
/// row, preserving which action button fired via `action_id`. Returns 1 on a
/// durable write, 0 on parse/insert failure.
@mutation fn handle_push_tap(json: str) to int {
    match std.json.parse(json) {
        Ok(j) => {
            let action_id = j.get("action_id").and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
            return _record_notification("tapped", json, action_id)
        }
        Error(_) => return 0
    }
}

/// Shared insert path for both push handlers. Parses `{title, body}` out of the
/// raw payload (retained verbatim in `payload_json` for forensics) and writes
/// one NotificationLog row.
fn _record_notification(kind: str, json: str, action_id: str) to int {
    match std.json.parse(json) {
        Ok(j) => {
            let title = j.get("title").and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
            let body = j.get("body").and_then(fn(x: Json) to Option[str] { x.as_str() }).unwrap_or("")
            match db.NotificationLog.insert({
                id: 0,
                kind: kind,
                title: title,
                body: body,
                action_id: action_id,
                payload_json: json,
                occurred_at: str(std.time.now_ms()),
            }) {
                Ok(_) => 1
                Error(_) => 0
            }
        }
        Error(_) => 0
    }
}

@push {
    on_register: store_push_token
    on_notification: handle_push_payload
    on_action: handle_push_tap
}

component SettingsPage() {
    state total: int = 0
    on mount: {
        total = health_event_count()
    }
    view: column(raw_class="mh-root") {
        NavBar()
        heading(level=2) { "Settings" }

        text(raw_class="mh-section-label") { "Your data" }
        text(raw_class="mh-sub") { str(total) + " events stored locally on this device." }
        text(raw_class="mh-sub") { "Timezone: UTC (events are stamped with the device tz at record time)." }

        text(raw_class="mh-section-label") { "Export" }
        link(href="/export") { "Download CSV / clinical HTML →" }

        text(raw_class="mh-section-label") { "Data safety" }
        text(raw_class="mh-sub") { "This log is append-only. Nothing is ever overwritten or deleted — edits are recorded as corrections and removals as tombstones, so your clinical history stays intact. To start fresh, export first, then archive the device store outside the app." }
    }
}

routes {
    "/" to Home
    "/mood" to MoodPage
    "/timeline" to TimelinePage
    "/weekly" to WeeklyPage
    "/export" to ExportPage
    "/voice" to VoicePage
    "/settings" to SettingsPage
}
