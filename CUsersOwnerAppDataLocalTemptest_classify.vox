fn classify(code: int) to str {
    return match code {
        0 => "ok"
        404 => return "not_found"
        500 => {
            let prefix = "server"
            prefix + "_error"
        }
        _ => "other"
    }
}

fn main() {
    print(classify(0))
    print(classify(404))
    print(classify(500))
    print(classify(999))
}
