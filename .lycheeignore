\.agents/.*
docs/news/templates/.*
.*iclr\.cc/.*
.*ascentcore\.com/.*
.*eslint-react.*
.*modelcontextprotocol\.io.*
.*docs\.doppler\.com.*
.*learn\.microsoft\.com.*
.*storage\.googleapis\.com.*
.*babel\.dev.*
.*diva-portal\.org.*
.*openreview\.net.*
