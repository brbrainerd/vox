// vox:caps fs
// migrate-arrows.vox - one-shot migrator. Revived 2026-05-24 against
// the hash-padded `r#"..."#` raw-string form.

import fs
import regex

fn migrate_file(file_path: str) {
    let content_res = fs.read_to_string(file_path)
    if content_res.is_err() { return }
    let content = content_res.unwrap()

    // Note: regex.replace returns Str directly (compile errors silently
    // discarded — corpus convention). No unwrap needed.
    let s1 = regex.replace(content, r#"\)\s*->\s*([A-Z][a-zA-Z0-9_\[\]]*)"#, ") to $1")
    let s2 = regex.replace(s1, r#"([a-zA-Z0-9_\)]+)\s*->\s*"#, "$1 => ")
    let s3 = regex.replace(s2, r#"\"\s*->\s*"#, "\" to ")
    let _ = fs.write_file(file_path, s3)
}

fn main() {
    let mut files = []
    let docs_glob = fs.glob("docs/src/**/*.md")
    if docs_glob.is_ok() {
        for f in docs_glob.unwrap() { files = files.push(f) }
    }
    let examples_glob = fs.glob("examples/golden/**/*.vox")
    if examples_glob.is_ok() {
        for f in examples_glob.unwrap() { files = files.push(f) }
    }

    for f in files {
        migrate_file(f)
        print("Migrated: " + f)
    }
}
