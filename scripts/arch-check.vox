// scripts/arch-check.vox
//
// Single source of truth for the architecture check CI step.
//
// Invokes `cargo run -p vox-arch-check --quiet` and forwards the exit code.
// .github/workflows/ci.yml calls this script so the invocation flags live in
// one place.
//
// Usage: vox run scripts/arch-check.vox
// Source of truth: docs/src/architecture/layers.toml

fn main() {
    print("Running vox-arch-check (layer + fan-in + LoC + orphan + docstring)...")

    let proc = process.run("cargo", ["run", "-p", "vox-arch-check", "--quiet"])
    if proc is null {
        log.error("vox-arch-check: could not spawn cargo")
        process.exit(1)
    }

    let res = proc.unwrap()
    if res.code == 0 {
        print("vox-arch-check: clean")
    } else {
        log.error("vox-arch-check: FAILED (exit " + str(res.code) + ")")
        process.exit(res.code)
    }
}
