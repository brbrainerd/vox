// walk_docs.vox — Recursive documentation walker for MENS corpus harvest.
// Extracts clean markdown + frontmatter from docs/src/ for the mens-lang domain.

fn walk_docs(root: str) -> list[str] {
    let mut files = [];
    let docs_dir = root + "/docs/src";
    
    if fs.exists(docs_dir) {
        print("walking docs: " + docs_dir);
        let found = fs.walk(docs_dir, "*.md");
        files = found;
    } else {
        print("warning: docs/src not found at " + docs_dir);
    }
    
    files
}

module.exports = walk_docs;
