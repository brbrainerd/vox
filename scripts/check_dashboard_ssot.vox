// scripts/check_dashboard_ssot.vox
//
// CI gate: fails if any .tsx file in crates/vox-dashboard/app/src/generated/
// was hand-edited rather than generated from a .vox source.
//
// Rule: every .tsx in generated/ must have its last git commit be one that
// also touched a .vox source file. If a .tsx was committed without any
// .vox change in the same commit, it was hand-edited.
//
// Usage: vox run scripts/check_dashboard_ssot.vox

// Single .vox source that produces every .tsx under generated/. Commits
// that touch generated/ MUST also touch this file; otherwise the .tsx
// is hand-edited.
fn canonical_vox_source() to str {
    return "crates/vox-dashboard/app/src/app.vox"
}

// Get the SHA of the commit that last touched the given path. Empty string
// means the file is untracked (newly-created in the working tree).
fn last_commit_for(file: str) to str {
    let proc = process.run("git", ["log", "-1", "--format=%H", "--", file])
    if proc is null { return "" }
    let res = proc.unwrap()
    if res.code != 0 { return "" }
    return res.stdout.trim()
}

// Return the file list of a commit (one per line).
fn files_in_commit(sha: str) to list[str] {
    let proc = process.run("git", ["show", "--name-only", "--format=", sha])
    if proc is null { return [] }
    let res = proc.unwrap()
    if res.code != 0 { return [] }
    return res.stdout.split("\n")
}

fn main() {
    print("Checking vox-dashboard generated/ SSoT integrity...")

    let generated_dir = "crates/vox-dashboard/app/src/generated"
    let vox_source_dir = "crates/vox-dashboard/app/src"

    if not fs.exists(generated_dir) {
        print("No generated/ directory — nothing to check.")
        return
    }

    let tsx_glob = fs.glob(generated_dir + "/**/*.tsx")
    if tsx_glob.is_err() {
        log.error("Cannot read " + generated_dir + ": " + tsx_glob.unwrap_err())
        process.exit(1)
    }
    let tsx_files = tsx_glob.unwrap()

    if tsx_files.len() == 0 {
        print("No .tsx files in generated/ — nothing to check.")
        return
    }

    // Confirm at least one .vox source exists in the source dir.
    let vox_glob = fs.glob(vox_source_dir + "/*.vox")
    if vox_glob.is_err() {
        log.error("Cannot enumerate .vox sources in " + vox_source_dir)
        process.exit(1)
    }
    let vox_sources = vox_glob.unwrap()
    if vox_sources.len() == 0 {
        log.error("SSOT violation: " + generated_dir + " contains .tsx files but " + vox_source_dir + " has no .vox sources.")
        log.error("Generated .tsx must come from vox build, not hand-written.")
        process.exit(1)
    }

    // Check git is available. If not, downgrade to "files-exist" check.
    let git_probe = process.run("git", ["rev-parse", "--is-inside-work-tree"])
    let mut git_available = false
    if git_probe isnt null {
        git_available = git_probe.unwrap().code == 0
    }

    if not git_available {
        log.warn("git not available — skipping commit-history check.")
        print("OK: " + str(tsx_files.len()) + " .tsx files found in generated/ with .vox sources present.")
        return
    }

    let canonical_source = canonical_vox_source()
    let mut violations = []

    for tsx_path in tsx_files {
        let last_commit = last_commit_for(tsx_path)
        if last_commit == "" {
            // Untracked — newly-created, not yet committed. Skip.
            continue
        }

        let touched = files_in_commit(last_commit)
        let touched_canonical = touched.any(fn(line: str) to bool {
            line.trim() == canonical_source
        })

        if not touched_canonical {
            let short_sha = last_commit.slice(0, 8)
            let msg = "  " + tsx_path + " (last commit " + short_sha + " did not touch " + canonical_source + ")"
            violations.push(msg)
        }
    }

    if violations.len() == 0 {
        print("OK: all " + str(tsx_files.len()) + " .tsx files in generated/ are consistent with .vox sources.")
        return
    }

    log.error("SSOT gate FAILED:")
    log.error("The following .tsx files in generated/ were not produced by `vox build`")
    log.error("(their last git commit touched no .vox source).")
    log.error("Hand-editing generated/ is forbidden — edit the .vox source and re-run `vox build`.")
    for v in violations {
        log.error(v)
    }
    process.exit(1)
}
