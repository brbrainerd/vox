// vox:caps fs env process
// CI canonical gate: `vox ci script-hygiene` — same allowlist as Rust (`SCRIPT_GLUE_ALLOWLIST` in matrix.rs).
// Does not run `vox check` on every `.vox` file (many scripts are stubs / transitional).
import fs;
import path;
import process;
import env;

fn main() {
    let mut root = ".";
    let root_opt = env.get("VOX_REPO_ROOT");
    if root_opt.is_some() {
        root = root_opt.unwrap();
    }
    
    // Canonical allowlist (all lowercase, forward slashes)
    let allowlist = [
        "scripts/vox-dev.sh",
        "scripts/windows/vox-dev.ps1",
        "scripts/coverage-graph/build_index.py",
        "scripts/coverage-graph/candidate_gaps.py",
        "scripts/coverage-graph/dup_and_wiring.py",
        "scripts/coverage-graph/emit_baseline.py",
        "scripts/coverage-graph/export_lcov_chunked.py",
        "scripts/coverage-graph/ingest_reaches.py",
        "scripts/coverage-graph/merge_behaviors_to_graph.py",
        "scripts/coverage-graph/os_compat.py",
        "scripts/coverage-graph/overlay_tests.py",
        "scripts/coverage-graph/rebuild_full_graph.py",
        "scripts/coverage-graph/recover_and_synth.py",
        "scripts/coverage-graph/test_overlay_tests.py"
    ];

    print("Running script-hygiene check...");
    let mut violations = [];

    let prohibited_exts = [".sh", ".ps1", ".py", ".bat", ".cmd"];
    let check_dirs = ["scripts"];
    
    for dir in check_dirs {
        let dir_path = path.join(root, dir);
        for ext in prohibited_exts {
            let pattern = dir_path + "/**/*" + ext;
            let found_res = fs.glob(pattern);
            if found_res.is_err() {
                continue;
            }
            let found = found_res.unwrap();
            for f in found {
                if f.contains("node_modules") {
                    continue;
                }
                // Normalize path: forward slashes and lowercase
                let f_norm = f.replace("\\", "/").to_lower();
                
                // Trim root prefix if present
                let mut f_rel = f_norm;
                if root isnt "." {
                    let mut root_norm = root.replace("\\", "/").to_lower();
                    if not root_norm.ends_with("/") {
                        root_norm = root_norm + "/";
                    }
                    if f_norm.starts_with(root_norm) {
                        f_rel = f_norm.replace(root_norm, "");
                    }
                } else {
                    if f_norm.starts_with("./") {
                        f_rel = f_norm.replace("./", "");
                    }
                }
                
                if not allowlist.contains(f_rel) {
                    violations = violations.push(f);
                }
            }
        }
    }

    if violations.len() > 0 {
        print("❌ Script hygiene violations found:");
        for v in violations {
            print("  - " + v);
        }
        print("\nPolicy: All project automation MUST be written as .vox files.");
        print("See AGENTS.md for details.");
        process.exit(1);
    }

    print("✅ Script hygiene check passed.");
}
