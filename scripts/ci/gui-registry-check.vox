// gui-registry-check.vox
// CI guard to verify TypeScript interface synchronization with Rust SSoT structure for the registry.

fn main() {
    let ts_file = "crates/vox-gui/ui/src/transport.ts";
    if not std.fs.exists(ts_file) {
        log.error("Could not find " + ts_file);
        std.process.exit(1);
    }

    let ts_content_res = std.fs.read_to_string(ts_file)
    if ts_content_res.is_err() {
        log.error("Could not read " + ts_file)
        std.process.exit(1)
    }
    let ts_content = ts_content_res.unwrap()

    // Ensure the interface defines all required SSoT fields
    let required_fields = [
        "path: string[]",
        "status: string",
        "product_lane: string | null",
        "feature_gate: string | null",
        "catalog_group: string | null",
        "surface: string"
    ];

    let mut missing = false;
    for field in required_fields {
        if not ts_content.contains(field) {
            log.error("Missing field in TS RegistryOperation: " + field);
            missing = true;
        }
    }

    if missing {
        log.error("gui-registry-check failed: TS interface drifted from RegistryFile SSoT.");
        std.process.exit(1);
    }

    print("gui-registry-check passed.");
}
