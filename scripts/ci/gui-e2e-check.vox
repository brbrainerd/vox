// gui-e2e-check.vox
// CI guard to validate the reactive push pipeline (Rust EventBus -> Tauri -> React State).

// vox:caps fs process env
import fs;
import path;
import process;

fn main() {
    print("Running GUI E2E validation suite via Playwright...");

    let ui_dir = "crates/vox-gui/ui";
    if not fs.exists(ui_dir) {
        log.error("GUI directory not found");
        process.exit(1);
    }
    
    // We execute pnpm exec playwright test to run the suite.
    // std.process.run_capture_ex(cmd, args, cwd, env) returns the
    // Result[{exit, stdout, stderr}] record (run_ex itself now returns Result[int]).
    print("Installing playwright browsers...");
    let install_res = std.process.run_capture_ex("pnpm", ["exec", "playwright", "install", "chromium"], ui_dir, []).unwrap();
    if install_res.exit isnt 0 {
        log.error("Failed to install playwright browsers:");
        log.error(install_res.stderr);
    }

    print("Executing tests...");
    let test_res = std.process.run_capture_ex("pnpm", ["run", "test:e2e"], ui_dir, []).unwrap();
    if test_res.exit isnt 0 {
        log.error("Playwright suite failed:");
        print(test_res.stdout);
        log.error(test_res.stderr);
        process.exit(1);
    }

    print("gui-e2e-check passed.");
}
