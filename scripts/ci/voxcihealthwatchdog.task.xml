<?xml version="1.0" encoding="UTF-16"?>
<!--
  Windows Task Scheduler definition for VoxCIHealthWatchdog.

  WHY THIS EXISTS: the CI Health Watchdog workflow (.github/workflows/ci-health-watchdog.yml)
  has a `schedule: */10` trigger, but GitHub Actions heavily THROTTLES high-frequency cron
  schedules — in practice it fires ~hourly with gaps, not every 10 min, so the "loud
  detection" safety net is mostly asleep. This local task drives the watchdog on a RELIABLE
  10-minute cadence via `gh workflow run` (workflow_dispatch) whenever the machine is on —
  which is exactly when the self-hosted fleet exists and most needs watching.

  The GitHub `schedule:` trigger is KEPT as the machine-off backstop (loose but
  machine-independent). This task is belt-and-suspenders, not a replacement: the watchdog
  must stay hosted so a machine-off scenario is still (loosely) covered.

  Install:  schtasks /Create /TN "VoxCIHealthWatchdog" /XML scripts\ci\voxcihealthwatchdog.task.xml /F  (elevated)
  Uninstall: schtasks /Delete /TN "VoxCIHealthWatchdog" /F
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Trigger the CI Health Watchdog (ci-health-watchdog.yml) every 10 minutes via `gh workflow run`, on a reliable local cadence — GitHub's */10 schedule is throttled to ~hourly. Source: scripts/ci/voxcihealthwatchdog.task.xml.</Description>
    <URI>\VoxCIHealthWatchdog</URI>
  </RegistrationInfo>
  <Triggers>
    <TimeTrigger>
      <Repetition>
        <Interval>PT10M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <DisallowStartOnRemoteAppSession>false</DisallowStartOnRemoteAppSession>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\GitHub CLI\gh.exe</Command>
      <Arguments>workflow run ci-health-watchdog.yml -R vox-foundation/vox</Arguments>
      <WorkingDirectory>C:\Users\Owner\vox</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
