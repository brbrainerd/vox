fn main() {
    let strays = [
        "build_errors.txt",
        "test_lexer.rs",
        "error.vox",
        "prototype_vox_tokenizer.json",
    ]
    for stray in strays {
        if fs.is_file(stray) {
            let _ = fs.remove(stray)
            print("Removed stray file: " + stray)
        }
    }

    // Check for codex-cutover-*.sidecar.json at repo root.
    let glob_res = fs.glob("./codex-cutover-*.sidecar.json")
    if glob_res.is_ok() {
        for path in glob_res.unwrap() {
            let _ = fs.remove(path)
            print("Removed stray sidecar: " + path)
        }
    }
}
