# Default: let Git classify text vs binary; normalize line endings per rules below.
* text=auto eol=lf

# Bash must stay LF (Windows Git Bash / CI).
*.sh text eol=lf

# PowerShell: CRLF on checkout for Windows editors (repo may still store normalized per Git version).
*.ps1 text eol=crlf

# Source, docs, and configs: LF everywhere for Linux CI and cross-platform diffs.
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.py text eol=lf
*.vox text eol=lf linguist-language=Vox linguist-detectable=true
*.gd text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Book/docs under docs/src (explicit; also covered by *.md).
docs/src/**/*.md text eol=lf

# Windows batch (if present): native CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binaries — do not touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.wasm binary
*.parquet binary
*.npy binary
*.npz binary
*.pt binary
*.pth binary
*.onnx binary
*.safetensors binary
*.bin binary

# --- Generated artifacts: collapse in diffs to save review + agent tokens ---
# `linguist-generated` collapses the file on GitHub diffs/PRs; `-diff` also collapses
# local `git diff`/`git show` (renders "Binary files differ", no line-by-line text).
# Only TRACKED, tool-regenerated files no human reads in a diff are listed here.
# (SUMMARY.md, feed.xml, and architecture-index.md are .gitignore'd — already out of
#  diffs — and research-index.md is hand-curated, so none of those are listed.)
#
# Committed generated docs (regen: `vox ci command-sync` / `generate-plugin-catalog-docs`):
docs/src/**/*.generated.md                                       linguist-generated=true -diff
# Generated GUI-surface SSOT reports (the "regenerate after merge" churn; regen: `vox ci gui-surface-*`):
contracts/reports/gui-surface-coverage.v1.json                   linguist-generated=true -diff
contracts/reports/gui-surface-registry.v1.json                   linguist-generated=true -diff
# Regenerated CLI-catalog golden (regen: `UPDATE_CLI_CATALOG_BASELINE=1 cargo test -p vox-cli`):
crates/vox-cli/tests/fixtures/command_catalog_paths_baseline.txt linguist-generated=true -diff
# Lockfile: collapse on GitHub but keep LOCALLY diffable (supply-chain review needs the text):
Cargo.lock                                                       linguist-generated=true
