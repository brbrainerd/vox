// CLI reference tour — build & project lifecycle commands.
// Each entry documents a real `vox <subcommand>` invocation.
//
// vox build src/main.vox              — compile a single .vox file to TypeScript
// vox check src/main.vox              — type-check without producing output
// vox compile                         — compile native / mobile packaging artifacts
// vox dev                             — watch and rebuild via vox-compilerd
// vox fmt src/main.vox                — format a Vox source file in place
// vox run src/main.vox                — build + cargo run in generated project
// vox test                            — run tests for the Vox program
// vox init                            — scaffold a new Vox project
// vox new web                         — scaffold from opinionated presets
// vox play                            — scaffold and immediately run a temp project
// vox script scripts/hello.vox       — execute a standalone Vox script
// vox add my-dep                      — add a dependency to Vox.toml
// vox remove my-dep                   — remove a dependency
// vox update                          — refresh vox.lock from local PM index
// vox lock                            — resolve Vox.toml and write vox.lock
// vox sync                            — materialize registry packages from vox.lock
// vox upgrade --source release        — toolchain upgrade
// vox fabrica compile                 — workshop lane (alias for build)
// vox emit client                     — emit focused codegen artifacts

fn cli_tour_build_and_project() to str {
  return "vox build / check / compile / dev / fmt / run / test / init / new / play / script / add / remove / update / lock / sync / upgrade / fabrica / emit"
}
