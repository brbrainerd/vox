// CLI reference tour — orchestration / auth / meta commands.
// Each entry documents a real `vox <subcommand>` invocation.
//
// vox auth                            — identity + master-key integration
// vox login                           — sign in: configure cloud vault URL + token + Clavis
// vox logout                          — sign out: clear vault credentials + login.toml
// vox config get key                  — manage global config + preferences
// vox plan create "ship X"            — agentic planning: create / replan / bypass
// vox workflow                        — workflow introspection: dry-run schedule preview
// vox stop                            — emergency stop the orchestrator (MCP / daemon)
// vox mcp                             — start the Vox MCP server
// vox lsp                             — start the Vox Language Server
// vox shell repl                      — interactive shell / PowerShell exec-policy check
// vox commands --recommended          — print dynamic command catalog from clap tree
// vox completions bash > vox.bash     — emit shell completions (bash/zsh/fish/pwsh/elvish)
// vox ext                             — extensions lane (legacy + ML subcommands)
// vox fabrica                         — workshop lane (alias for build)
// vox emit client                     — emit focused codegen artifacts
// vox diag doctor                     — diagnostics lane (doctor / architect / stub-check)
// vox drift-check                     — workspace drift + pattern-repetition linter
// vox snapshot orphans                — snapshot helper (covered in tour 2)
// vox telemetry upload                — optional telemetry upload queue (per ADR 023)
// vox ci sync-ignore-files            — CI guards (manifest / SSOT / feature matrix)

fn cli_tour_orchestration_and_meta() to str {
  return "vox auth / login / logout / config / plan / workflow / stop / mcp / lsp / shell / commands / completions / ext / fabrica / emit / diag / drift-check / telemetry / ci"
}
