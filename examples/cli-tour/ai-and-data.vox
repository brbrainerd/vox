// CLI reference tour — AI / ML / data commands.
// Each entry documents a real `vox <subcommand>` invocation.
//
// vox llm prompt                      — LLM-native context and prompt generation
// vox generate "build me X"           — generate Vox code from a natural-language prompt (MENS)
// vox repair --project apps/foo       — automatic syntax/type repair via LLM
// vox grammar export bnf              — export the Vox language grammar (for MENS training)
// vox oratio transcribe in.wav        — speech-to-code (alias: speech)
// vox ars                             — Vox Ars (legacy ML lane)
// vox db schema                       — local VoxDB schema / preferences
// vox memory search "actor"           — hybrid retrieval over memory + project DB
// vox scientia                        — research / capability map facade
// vox schola                          — scholarship / Scientia domain
// vox codex verify                    — Codex / Arca database tools
// vox catalog list                    — manage .vox/repositories.yaml catalog
// vox repo status                     — repository discovery + cross-repo catalog
// vox model list                      — manage models: discovery / scoreboard / explainability
// vox research run my-experiment      — unified research operations
// vox mens train                      — MENS train / serve / probe (delegated to vox-ml-cli)
// vox populi status                   — mesh coordination (delegated to vox-ml-cli)
// vox train my-data                   — alias for `mens train`
// vox dispatch                        — dispatch-time routing preview

fn cli_tour_ai_and_data() to str {
  return "vox llm / generate / repair / grammar / oratio / ars / db / memory / scientia / schola / codex / catalog / repo / model / research / mens / populi / train / dispatch"
}
