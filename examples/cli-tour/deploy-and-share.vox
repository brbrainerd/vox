// CLI reference tour — deploy / share / packaging commands.
// Each entry documents a real `vox <subcommand>` invocation.
//
// vox deploy                          — deploy from Vox.toml [deploy] (OCI / compose / k8s / SSH)
// vox share apps/marquee/todo-auth    — share a Vox app via a public URL tunnel
// vox snapshot orphans --clean        — Insta snapshot helpers (detect / clean orphans)
// vox rollback                        — roll back orchestration stack via vox-bounded-fs ledger
// vox bundle list                     — list plugin distribution bundles
// vox bundle build my-bundle          — build a plugin bundle
// vox bundle-app apps/marquee/chat    — bundle an app for distribution
// vox plugin install my-plugin        — install a Vox plugin
// vox snippet save my-snippet         — local snippet store helper
// vox pm search foo                   — advanced package-manager / registry commands
// vox migrate web                     — source migrations (React interop / retired web syntax)

fn cli_tour_deploy_and_share() to str {
  return "vox deploy / share / snapshot / rollback / bundle / bundle-app / plugin / snippet / pm / migrate"
}
