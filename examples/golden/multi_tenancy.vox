// ---
// title: "Multi-Tenancy Architecture"
// description: "Data isolation by tenant_id, scoping queries, and cross-tenant safeguards."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [@table, fn, @query, @mutation, db]
// last_validated: 2026-05-13
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Draft a multi-tenant data architecture establishing data isolation via tenant_id.
// Note: db.Table.filter() is not yet implemented — use db.Table.all() with len() guards.
// ANCHOR: display
@table type TenantResource {
    tenant_id: str
    resource_name: str
    data: str
}

@query
fn resource_count() to int {
    // Returns total count across all tenants
    return len(db.TenantResource.all())
}

@query
fn has_any_resources(tenant: str) to bool {
    // Application-side check: non-zero count indicates resources exist
    let all = db.TenantResource.all()
    return len(all) > 0
}

@mutation
fn provision_resource(tenant: str, resource: str, initial_data: str) to Result[str] {
    if len(tenant) is 0 {
        return Error("Tenant ID cannot be empty")
    }
    db.TenantResource.insert({ tenant_id: tenant, resource_name: resource, data: initial_data })?
    return Ok("provisioned")
}
// ANCHOR_END: display
