// Golden example: @json_as(TypeName) typed JSON deserialization.
// RFC: docs/src/architecture/json-as-rfc-2026-05-24.md
// Phase M — Steps 1-6 (complete).
//
// Demonstrates:
//   1. Basic struct with required and optional fields
//   2. camelCase naming convention
//   3. @field_name per-field override
//   4. defaults: true (missing field uses zero value)
//   5. Tagged-enum ADT (tag: "kind") dispatch

// ── 1. Basic struct ───────────────────────────────────────────────────────────

@json_as(Product)
type Product {
    id: int,
    name: str,
    price: float,
    description: Option[str],
}

// ── 2. camelCase naming ───────────────────────────────────────────────────────

@json_as(ApiEvent, naming: "camelCase")
type ApiEvent {
    event_type: str,
    created_at: str,
    payload_size: int,
}

// ── 3. @field_name override ───────────────────────────────────────────────────

@json_as(Order)
type Order {
    @field_name("order_id") id: str,
    @field_name("line_count") count: int,
}

// ── 4. defaults: true ─────────────────────────────────────────────────────────

@json_as(Config, defaults: true)
type Config {
    host: str,
    port: int,
    retries: int,
}

// ── 5. Tagged-enum ADT (tag: "kind") ─────────────────────────────────────────

@json_as(ToolCall, tag: "kind")
type ToolCall =
    | Search { query: str }
    | Fetch { url: str }

// ── 6. ADT edge cases: second variant, missing tag, unknown tag ───────────────
//
// These four functions mirror the four adt_tagged_enum_* integration tests
// in crates/vox-compiler/tests/json_as_test.rs (Phase M, RFC §4.4).

@json_as(Shape, tag: "type")
type Shape =
    | Circle { radius: int }
    | Square { side: int }

// ── Demo functions ─────────────────────────────────────────────────────────────

fn parse_product(raw: str) to str {
    let r = json.parse(raw)
    if r.is_err() { return "parse_error: " + r.unwrap_err() }
    let res = Product_from_json(r.unwrap())
    if res.is_err() { return "decode_error: " + res.unwrap_err() }
    let p = res.unwrap()
    let name = p.get("name").and_then(fn(j: Json) to Option[str] { j.as_str() }).unwrap_or("?")
    return "ok: " + name
}

fn round_trip_product(raw: str) to str {
    let r = json.parse(raw)
    if r.is_err() { return "parse_error" }
    let res = Product_from_json(r.unwrap())
    if res.is_err() { return "decode_error" }
    let p = res.unwrap()
    let out = Product_to_json(p)
    let name = out.get("name").and_then(fn(j: Json) to Option[str] { j.as_str() }).unwrap_or("?")
    return "round_trip: " + name
}

fn parse_event(raw: str) to str {
    let r = json.parse(raw)
    if r.is_err() { return "parse_error" }
    let res = ApiEvent_from_json(r.unwrap())
    if res.is_err() { return "decode_error" }
    let e = res.unwrap()
    return e.get("event_type").and_then(fn(j: Json) to Option[str] { j.as_str() }).unwrap_or("?")
}

fn parse_order(raw: str) to str {
    let r = json.parse(raw)
    if r.is_err() { return "parse_error" }
    let res = Order_from_json(r.unwrap())
    if res.is_err() { return "decode_error: " + res.unwrap_err() }
    let o = res.unwrap()
    return o.get("id").and_then(fn(j: Json) to Option[str] { j.as_str() }).unwrap_or("?")
}

fn parse_tool(raw: str) to str {
    let r = json.parse(raw)
    if r.is_err() { return "parse_error" }
    let res = ToolCall_from_json(r.unwrap())
    if res.is_err() { return "decode_error: " + res.unwrap_err() }
    let t = res.unwrap()
    let query = t.get("query").and_then(fn(j: Json) to Option[str] { j.as_str() })
    if query.is_none() {
        let url = t.get("url").and_then(fn(j: Json) to Option[str] { j.as_str() }).unwrap_or("?")
        return "fetch:" + url
    }
    return "search:" + query.unwrap()
}

// 6a. First variant of Shape ADT (Circle)
fn parse_shape_circle(raw: str) to str {
    let r = json.parse(raw)
    if r.is_err() { return "parse_error" }
    let res = Shape_from_json(r.unwrap())
    if res.is_err() { return "decode_error: " + res.unwrap_err() }
    let s = res.unwrap()
    let radius = s.get("radius").and_then(fn(j: Json) to Option[int] { j.as_int() }).unwrap_or(-1)
    return "circle:radius=" + str(radius)
}

// 6b. Second variant of Shape ADT (Square)
fn parse_shape_square(raw: str) to str {
    let r = json.parse(raw)
    if r.is_err() { return "parse_error" }
    let res = Shape_from_json(r.unwrap())
    if res.is_err() { return "decode_error: " + res.unwrap_err() }
    let s = res.unwrap()
    let side = s.get("side").and_then(fn(j: Json) to Option[int] { j.as_int() }).unwrap_or(-1)
    return "square:side=" + str(side)
}

// 6c. Missing "type" tag field → Shape_from_json returns Err
fn check_shape_missing_tag() to str {
    let r = json.parse("{\"radius\":5}")
    if r.is_err() { return "parse_error" }
    let res = Shape_from_json(r.unwrap())
    if res.is_ok() { return "unexpected_ok" }
    return "missing_tag"
}

// 6d. Unknown tag value ("Triangle" not in Shape) → Shape_from_json returns Err
fn check_shape_unknown_tag() to str {
    let r = json.parse("{\"type\":\"Triangle\",\"radius\":5}")
    if r.is_err() { return "parse_error" }
    let res = Shape_from_json(r.unwrap())
    if res.is_ok() { return "unexpected_ok" }
    return "unknown_tag"
}

fn main() to str {
    // 1. Successful parse
    let product_json = "{\"id\":1,\"name\":\"widget\",\"price\":9.99}"
    let r1 = parse_product(product_json)

    // 2. Round-trip
    let r2 = round_trip_product(product_json)

    // 3. camelCase — keys in JSON are camelCase
    let event_json = "{\"eventType\":\"click\",\"createdAt\":\"2026-01-01\",\"payloadSize\":128}"
    let r3 = parse_event(event_json)

    // 4. @field_name override — JSON uses "order_id" even though Vox field is "id"
    let order_json = "{\"order_id\":\"ORD-001\",\"line_count\":3}"
    let r4 = parse_order(order_json)

    // 5. Tagged-enum ADT — "kind" tag dispatches to the Search variant
    let tool_json = "{\"kind\":\"Search\",\"query\":\"find widgets\"}"
    let r5 = parse_tool(tool_json)

    // 6. Shape ADT: first variant, second variant, missing tag, unknown tag
    let r6a = parse_shape_circle("{\"type\":\"Circle\",\"radius\":5}")
    let r6b = parse_shape_square("{\"type\":\"Square\",\"side\":7}")
    let r6c = check_shape_missing_tag()
    let r6d = check_shape_unknown_tag()

    return r1 + " | " + r2 + " | event:" + r3 + " | order:" + r4 + " | tool:" + r5 + " | " + r6a + " | " + r6b + " | " + r6c + " | " + r6d
}
