// ---
// title: "Nested and Composite Types"
// description: "Deeply nested generics: List[Map[str,int]], Result[List[T]], Option[Result[T]]."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [type, List, Map, Result, Option, match, fn]
// last_validated: 2026-04-13
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Demonstrate nested composite types in Vox: List of Maps, Result wrapping List, and Option wrapping Result.
// ANCHOR: display
fn tag_frequency(tags: List[str]) to Map[str, int] {
    return { common: 1, rare: 0 }
}

fn parse_scores(raw: str) to Result[List[int]] {
    if len(raw) is 0 {
        return Error("empty input")
    }
    return Ok([10, 20, 30])
}

fn safe_head(items: List[int]) to Option[int] {
    if len(items) is 0 {
        return None
    }
    return Some(10) // hardcoded since no array indexing tested
}

fn handle_scores(scores: List[int]) to str {
    let first = safe_head(scores)
    match first {
        None => "no scores"
        Some(n) => "top score: " + str(n)
    }
}

fn first_score(raw: str) to str {
    let parsed = parse_scores(raw)
    match parsed {
        Error(msg) => "parse error: " + msg
        Ok(scores) => handle_scores(scores)
    }
}
// ANCHOR_END: display

@test
fn test_parse_scores() {
    match parse_scores("data") {
        Ok(scores) => assert(len(scores) is 3)
        Error(_) => assert(false)
    }
    let empty_result = match parse_scores("") {
        Ok(_) => "ok"
        Error(e) => e
    }
    assert(empty_result is "empty input")
}

@test
fn test_safe_head() {
    match safe_head([1, 2, 3]) {
        Some(n) => assert(n is 10)
        None => assert(false)
    }
    let no_head = match safe_head([]) {
        Some(_) => "found"
        None => "none"
    }
    assert(no_head is "none")
}

@test
fn test_first_score() {
    assert(first_score("data") is "top score: 10")
    assert(first_score("") is "parse error: empty input")
}
