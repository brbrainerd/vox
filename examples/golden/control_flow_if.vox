// ---
// title: "Control Flow: If/Else Expressions"
// description: "if/else as expressions, nested conditionals, guard clauses in functions."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, if, else, let, match]
// last_validated: 2026-04-13
// training_eligible: true
// training_weight: 1.0
// difficulty: beginner
// ---
// @training_prompt: Demonstrate Vox if/else as expressions, nested conditionals, and guard patterns.
// ANCHOR: display
fn classify_score(score: int) to str {
    if score >= 90 {
        return "A"
    } else {
        if score >= 80 {
            return "B"
        } else {
            if score >= 70 {
                return "C"
            } else {
                return "F"
            }
        }
    }
}

fn access_level(role: str, active: bool) to str {
    if not active {
        return "suspended"
    }
    if role is "admin" {
        return "full"
    }
    if role is "editor" {
        return "write"
    }
    return "read"
}

fn shipping_cost(weight: int, express: bool) to int {
    let base = if weight > 10 { 20 } else { 5 }
    let surcharge = if express { 15 } else { 0 }
    return base + surcharge
}

fn is_valid_username(name: str) to bool {
    if len(name) < 3 {
        return false
    }
    if len(name) > 32 {
        return false
    }
    return true
}
// ANCHOR_END: display

@test
fn test_classify_score() {
    assert(classify_score(95) is "A")
    assert(classify_score(85) is "B")
    assert(classify_score(72) is "C")
    assert(classify_score(60) is "F")
}

@test
fn test_access_level() {
    assert(access_level("admin", true) is "full")
    assert(access_level("editor", true) is "write")
    assert(access_level("viewer", true) is "read")
    assert(access_level("admin", false) is "suspended")
}

@test
fn test_shipping_cost() {
    assert(shipping_cost(5, false) is 5)
    assert(shipping_cost(5, true) is 20)
    assert(shipping_cost(15, false) is 20)
    assert(shipping_cost(15, true) is 35)
}

@test
fn test_is_valid_username() {
    assert(is_valid_username("ab") is false)
    assert(is_valid_username("abc") is true)
    assert(is_valid_username("validname") is true)
}
