// ---
// title: "Database Operations Golden"
// description: "Exhaustive db.* surface: CRUD, predicate algebra, ordering/limit/projection, endpoint handlers — each verified by @test under --mode interp."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [@table, @query, @mutation, @test, db, fn, match]
// last_validated: 2026-06-03
// training_eligible: true
// training_weight: 1.0
// ---
// @training_prompt: Demonstrate the full Vox database surface — @table declarations, insert/all/get/find/delete/count, where-predicate algebra (eq/neq/lt/lte/gt/gte/contains/in/is_null/and/or/not), order_by/limit/select, and @query/@mutation handlers — with @test functions that assert the observable behavior of each.

// ─────────────────────────────────────────────────────────────────────────────
// 1. CRUD lifecycle — insert (returns the new _id), all, count, get/find, delete.
// ─────────────────────────────────────────────────────────────────────────────
@table type Widget {
    label: str
    qty: int
}

@test fn widget_crud_lifecycle() {
    // insert returns a monotonic _id starting at 0.
    assert(db.Widget.insert({ label: "alpha", qty: 3 }).unwrap() is 0)
    assert(db.Widget.insert({ label: "beta", qty: 7 }).unwrap() is 1)
    assert(db.Widget.insert({ label: "gamma", qty: 1 }).unwrap() is 2)

    assert(len(db.Widget.all()) is 3)
    assert(db.Widget.count().unwrap() is 3)

    // get(id) and its alias find(id) return Option[Record].
    let hit = match db.Widget.get(1).unwrap() {
        Some(row) => row.label
        None => "missing"
    }
    assert(hit is "beta")
    let aliased = match db.Widget.find(2).unwrap() {
        Some(row) => row.label
        None => "missing"
    }
    assert(aliased is "gamma")

    // get on an absent id is None.
    let absent = match db.Widget.get(99).unwrap() {
        Some(row) => "found"
        None => "none"
    }
    assert(absent is "none")

    // delete removes by _id.
    db.Widget.delete(0)
    assert(db.Widget.count().unwrap() is 2)
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. Numeric comparison predicates — gte / lte / gt / lt / neq / eq-shorthand.
// ─────────────────────────────────────────────────────────────────────────────
@table type Score {
    who: str
    points: int
}

@test fn numeric_predicates() {
    db.Score.insert({ who: "a", points: 10 })
    db.Score.insert({ who: "b", points: 20 })
    db.Score.insert({ who: "c", points: 30 })

    assert(len(db.Score.where({ points: { gte: 20 } })) is 2)
    assert(len(db.Score.where({ points: { lte: 20 } })) is 2)
    assert(len(db.Score.where({ points: { gt: 10 } })) is 2)
    assert(len(db.Score.where({ points: { lt: 20 } })) is 1)
    assert(len(db.Score.where({ points: { neq: 20 } })) is 2)
    // Bare value is equality shorthand.
    assert(len(db.Score.where({ points: 20 })) is 1)
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. Boolean / set / text predicates — and / or / not / in / contains.
// ─────────────────────────────────────────────────────────────────────────────
@table type Member {
    handle: str
    tier: int
    vip: bool
}

@test fn boolean_set_and_text_predicates() {
    db.Member.insert({ handle: "ann", tier: 1, vip: true })
    db.Member.insert({ handle: "bob", tier: 2, vip: false })
    db.Member.insert({ handle: "cat", tier: 3, vip: true })

    // and: tier > 1 AND vip == true  → only "cat".
    assert(len(db.Member.where({ and: [{ tier: { gt: 1 } }, { vip: true }] })) is 1)
    // or: tier == 1 OR tier == 3 → "ann" + "cat".
    assert(len(db.Member.where({ or: [{ tier: 1 }, { tier: 3 }] })) is 2)
    // not: NOT vip → "bob".
    assert(len(db.Member.where({ not: { vip: true } })) is 1)
    // in: tier in {1, 3} → 2 rows.
    assert(len(db.Member.where({ tier: { in: [1, 3] } })) is 2)
    // contains: handle contains "a" → "ann" + "cat".
    assert(len(db.Member.where({ handle: { contains: "a" } })) is 2)
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. Ordering, limit, and projection over an unfiltered scan.
// ─────────────────────────────────────────────────────────────────────────────
@table type Rank {
    name: str
    elo: int
}

@test fn ordering_limit_and_projection() {
    db.Rank.insert({ name: "high", elo: 90 })
    db.Rank.insert({ name: "low", elo: 5 })
    db.Rank.insert({ name: "mid", elo: 40 })

    // Ascending → lowest elo first.
    let asc = db.Rank.all().order_by("elo", true).unwrap()
    assert(asc.first().unwrap().name is "low")
    // Descending → highest elo first.
    let desc = db.Rank.all().order_by("elo", false).unwrap()
    assert(desc.first().unwrap().name is "high")
    // limit caps the row count.
    assert(len(db.Rank.all().order_by("elo", true).limit(2)) is 2)
    // select keeps the projected columns; row count is unchanged.
    assert(len(db.Rank.all().select("name")) is 3)
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. Endpoint handlers — @query / @mutation are ordinary callables in interp.
// ─────────────────────────────────────────────────────────────────────────────
@table type Note {
    body: str
}

@query fn note_count() to int {
    return len(db.Note.all())
}

@mutation fn add_note(body: str) to int {
    return db.Note.insert({ body: body }).unwrap()
}

@test fn endpoint_handlers_run() {
    assert(add_note("first") is 0)
    assert(add_note("second") is 1)
    assert(note_count() is 2)
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. Documented limitation — a fused predicate chain (`.where(..).select(..)`)
//    cannot resolve the inner predicate value under --mode interp, so it fails
//    loudly with an Err rather than returning silently-wrong rows. Run a single
//    `.where`/`.filter`, or use --mode script, for filtered projections.
// ─────────────────────────────────────────────────────────────────────────────
@table type Account {
    owner: str
    balance: int
}

@test fn fused_predicate_chain_fails_loudly() {
    db.Account.insert({ owner: "x", balance: 5 })
    let outcome = match db.Account.where({ balance: { gte: 100 } }).select("owner") {
        Ok(rows) => "silently-wrong"
        Error(e) => "loud-err"
    }
    assert(outcome is "loud-err")
}
