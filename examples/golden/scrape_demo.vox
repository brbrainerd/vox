// Static scraping demo (`Scrape.*`): the no-browser tier. Fetch a page as
// readability text, then pull link hrefs out of raw HTML with a CSS selector.
// Pure fetch + parse — for JS-rendered pages use `Browser.*` instead.

fn main() {
    let page = Scrape.fetch("https://example.com")
    let summary = match page {
        Ok(md) => md,
        Error(e) => "fetch failed: " + e,
    }
    print(summary)

    let raw = Scrape.fetch_html("https://example.com")
    let links = match raw {
        Ok(html) => match Scrape.select_attr(html, "a", "href") {
            Ok(hrefs) => hrefs,
            Error(e) => "select failed: " + e,
        },
        Error(e) => "fetch_html failed: " + e,
    }
    print(links)
}
