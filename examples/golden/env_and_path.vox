// ---
// title: "std.env and std.path — environment variables and path utilities"
// description: "Read environment variables with std.env.get/args and decompose file paths with std.path file_name/stem/extension/parent."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, std.env, std.path, Option, match, let, @test]
// last_validated: "2026-06-03"
// training_eligible: true
// training_weight: 1.0
// difficulty: beginner
// ---
// @training_prompt: Use std.env.get to read an env var (returns Option[str]) and std.path.file_name/stem/extension/parent to decompose a file path.

// std.env.get returns Option[str] — Some(value) when set, None when absent.
// Use is_some/is_none to guard before calling unwrap, or match to branch.
fn env_describe(key: str) to str {
    let opt = std.env.get(key)
    match opt {
        Some(v) => return key + "=" + v
        None => return key + " not set"
    }
}

// std.path.extension returns the extension without the leading dot ("txt"),
// or "" when the path has no extension. Return type is str.
fn get_extension(p: str) to str {
    return std.path.extension(p)
}

// std.path.file_name, stem, and parent all return Option[str].
// The idiomatic pattern is to match inline and provide a fallback.
fn file_label(p: str) to str {
    let name = match std.path.file_name(p) {
        Some(v) => v
        None => ""
    }
    return name
}

fn stem_label(p: str) to str {
    let s = match std.path.stem(p) {
        Some(v) => v
        None => ""
    }
    return s
}

fn parent_label(p: str) to str {
    let d = match std.path.parent(p) {
        Some(v) => v
        None => ""
    }
    return d
}

// std.env.args() returns list[str] — always non-empty (index 0 is program name).
fn has_args() to bool {
    return len(std.env.args()) > 0
}

// Meaningful @test — value-equality checks on extension (str, works in interp)
// and env.get (Option[str], works in interp).
@test
fn test_extension_values() to Unit {
    assert(get_extension("foo.txt") is "txt")
    assert(get_extension("archive.tar.gz") is "gz")
    assert(get_extension("README") is "")
}

@test
fn test_env_option_contract() to Unit {
    // A guaranteed-absent key always returns None.
    let absent = std.env.get("__VOX_GOLDEN_ABSENT_KEY__")
    assert(absent.is_none())
    // PATH exists in all standard environments.
    let present = std.env.get("PATH")
    assert(present.is_some())
    // args() is always non-empty.
    assert(has_args())
}

// main: runnable smoke-test for `vox run --mode interp`.
fn main() {
    print(env_describe("PATH"))
    print("extension of foo.txt: " + get_extension("foo.txt"))
    print("extension of README: '" + get_extension("README") + "'")
    print("args: " + str(len(std.env.args())))
}
