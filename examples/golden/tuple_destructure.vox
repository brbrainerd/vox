// ---
// title: "Tuple Construction, Destructuring, and Indexed Iteration"
// description: "Build 2- and 3-element tuples, destructure with let and match patterns, and use for v, i in list indexed loops."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, let, match, tuple, for, @test]
// last_validated: "2026-06-03"
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Demonstrate Vox tuple construction, let/match destructuring, and indexed for-loop iteration.

// sum_pair constructs a 2-element tuple then destructures it with let
fn sum_pair(a: int, b: int) to int {
    let t = (a, b)
    let (x, y) = t
    return x + y
}

// describe_point constructs a 3-element tuple and matches on its pattern
fn describe_point(px: int, py: int, pz: int) to str {
    let pt = (px, py, pz)
    match pt {
        (0, 0, 0) => return "origin"
        (x, y, z) => return "(" + str(x) + "," + str(y) + "," + str(z) + ")"
    }
}

// classify_pair matches on a (score, label) tuple to produce a verdict
fn classify_pair(score: int, label: str) to str {
    let result = (score, label)
    match result {
        (s, lbl) => {
            if s >= 90 {
                return "excellent: " + lbl
            }
            if s >= 60 {
                return "passing: " + lbl
            }
            return "failing: " + lbl
        }
    }
}

// weighted_sum uses indexed for-loop: for v, i in list binds value and index.
// Each element is multiplied by (index + 1) and accumulated.
fn weighted_sum(values: list[int]) to int {
    let mut total = 0
    for v, i in values {
        total = total + v * (i + 1)
    }
    return total
}

// index_labels tags each string element with its position using for v, i in list
fn index_labels(items: list[str]) to list[str] {
    let mut result: list[str] = []
    for v, i in items {
        result.push(str(i) + ":" + v)
    }
    return result
}

@test
fn test_tuple_construction_and_destructuring() to Unit {
    // 2-element tuple: construct then let-destructure
    assert(sum_pair(10, 30) is 40)
    assert(sum_pair(0, 7) is 7)

    // 3-element tuple: match on specific (origin) pattern
    assert(describe_point(0, 0, 0) is "origin")
    // 3-element tuple: match on wildcard pattern with bound vars
    assert(describe_point(1, 2, 3) is "(1,2,3)")

    // match on a (score, label) tuple
    assert(classify_pair(95, "math") is "excellent: math")
    assert(classify_pair(70, "history") is "passing: history")
    assert(classify_pair(45, "art") is "failing: art")
}

@test
fn test_indexed_for_loop() to Unit {
    // weighted sum: 5*(1) + 10*(2) + 3*(3) = 5 + 20 + 9 = 34
    assert(weighted_sum([5, 10, 3]) is 34)
    // single element: 7*(0+1) = 7
    assert(weighted_sum([7]) is 7)

    // for v, i in list — index_labels tags elements by position
    let labels = index_labels(["a", "b", "c"])
    match labels[0] {
        Some(v) => assert(v is "0:a")
        None => assert(false)
    }
    match labels[2] {
        Some(v) => assert(v is "2:c")
        None => assert(false)
    }
}

// EXPECT: ok
fn main() to str {
    test_tuple_construction_and_destructuring()
    test_indexed_for_loop()
    return "ok"
}
