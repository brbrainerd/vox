// ---
// title: "Index Showcase"
// description: "Consolidated examples for the Vox homepage."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [@table, @server, component, @mcp.tool]
// last_validated: 2026-05-13
// training_eligible: true
// training_weight: 1.0
// difficulty: advanced
// ---

// ANCHOR: data
@table type Task {
    title: str
    done: bool
}

@table type Docs {
    context: str
}

@server fn complete_task(id: Id[Task]) to Result[str] {
    // Mark complete by re-inserting with done=true (update not yet implemented)
    db.Task.insert({ title: "completed", done: true })?
    return Ok("completed")
}
// ANCHOR_END: data

// ANCHOR: ui
component TaskList(tasks: List[Task]) {
    view: column() {
        text() { "Tasks" }
    }
}
// ANCHOR_END: ui

// ANCHOR: mcp
@mcp.tool "search_docs: Search documentation for a query"
fn search_docs(query: str) to int {
    // Returns count of matching docs; raw SQL not supported; use typed db operations
    let docs = db.Docs.all()
    return len(docs)
}
// ANCHOR_END: mcp
