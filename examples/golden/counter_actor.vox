// ---
// title: "Counter Actor Example"
// description: "Concurrent actor with mailbox. Handler increments a passed-in counter step (persistent `state` inside actor blocks is not parsed yet)."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, return]
// last_validated: 2026-03-26
// training_eligible: true
// training_weight: 1.0
// difficulty: beginner
// ---
// @training_prompt: Define a Vox actor with an Increment handler that returns the next value.
// ANCHOR: display
fn CounterActor_Increment(current: int) to int {
    return current + 1
}
// ANCHOR_END: display

@test
fn test_counter_increment() {
    assert(CounterActor_Increment(0) is 1)
    assert(CounterActor_Increment(5) is 6)
    assert(CounterActor_Increment(99) is 100)
}
