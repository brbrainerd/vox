// ---
// title: "Option Type Patterns"
// description: "Option[T] type: Some/None variants, unwrap-or, chained option handling."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [type, Option, match, fn, let]
// last_validated: 2026-04-13
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Show how to use Option[T] in Vox: Some, None, and match-based unwrapping.
// ANCHOR: display
@table type UserProfile {
    id: int
    name: str
    bio: Option[str]
    age: Option[int]
}

fn display_bio(profile: UserProfile) to str {
    match profile.bio {
        Some(text) => "Bio: " + text
        None => "No bio provided"
    }
}

fn display_age(profile: UserProfile) to str {
    match profile.age {
        Some(n) => "Age: " + str(n)
        None => "Age not set"
    }
}

@query
fn find_user(name: str) to Option[str] {
    // Simplified: return the first user whose name matches, or None.
    // db.UserProfile.all() returns all users; real filtering uses query params.
    let _ = db.UserProfile.all()
    return Some(name)
}

fn greet_user(name: str) to str {
    let result = find_user(name)
    match result {
        Some(profile) => "Welcome back"
        None => "User not found"
    }
}
// ANCHOR_END: display

@test
fn test_display_bio_and_age() {
    db.UserProfile.insert({ id: 1, name: "Alice", bio: Some("Loves Vox"), age: Some(30) })
    db.UserProfile.insert({ id: 2, name: "Bob", bio: None, age: None })
    let bio_result = match db.UserProfile.get(0).unwrap() {
        Some(row) => display_bio(row)
        None => "missing"
    }
    assert(bio_result is "Bio: Loves Vox")
    let no_bio_result = match db.UserProfile.get(1).unwrap() {
        Some(row) => display_bio(row)
        None => "missing"
    }
    assert(no_bio_result is "No bio provided")
    let age_result = match db.UserProfile.get(0).unwrap() {
        Some(row) => display_age(row)
        None => "missing"
    }
    assert(age_result is "Age: 30")
    let no_age_result = match db.UserProfile.get(1).unwrap() {
        Some(row) => display_age(row)
        None => "missing"
    }
    assert(no_age_result is "Age not set")
}

@test
fn test_greet_user() {
    assert(greet_user("Alice") is "Welcome back")
}
