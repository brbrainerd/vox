// ---
// title: "Advanced Database Queries"
// description: "Aggregation and composition of database operations via db.*"
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [@table, db, match, fn, @query, @mutation]
// last_validated: 2026-05-13
// training_eligible: true
// training_weight: 1.0
// ---
// @training_prompt: Show database operations in Vox: all(), insert(), get(), and aggregations via len().
// Note: db.Table.filter() is not yet implemented; filtering is done application-side via len() guards.
// ANCHOR: display
@table type Product {
    name: str
    category: str
    price: int
    in_stock: bool
}

@query
fn product_count() to int {
    return len(db.Product.all())
}

@query
fn all_products() to int {
    // Returns total count — application-side filtering for category/stock applies
    let all = db.Product.all()
    return len(all)
}

@mutation
fn restock(name: str, price: int) to Result[str] {
    db.Product.insert({ name: name, category: "general", price: price, in_stock: true })?
    return Ok("restocked")
}

@mutation
fn add_product(name: str, category: str, price: int) to Result[str] {
    db.Product.insert({ name: name, category: category, price: price, in_stock: true })?
    return Ok("added")
}
// ANCHOR_END: display
