// ANCHOR: start
// ANCHOR: data_model
@table type Note {
    title: str
    content: str
}
// ANCHOR_END: data_model

@server fn health() to Result[str] {
    return Ok("ok")
}

// ANCHOR: ui
component App() {
    view: text() { "Hello Vox" }
}
// ANCHOR_END: ui


// ANCHOR_END: start

// ANCHOR: concepts
// ANCHOR: logic
@query fn get_notes() to int {
    // Returns note count; db.Note.all() returns a list
    return len(db.Note.all())
}

@mutation fn create_note(title: str, content: str) to Result[str] {
    db.Note.insert({ title: title, content: content })?
    return Ok("created")
}

fn order(id: str) to Result[str] {
    return Ok("ordered:" + id)
}

@test
fn test_order() {
    match order("abc") {
        Ok(msg) => assert(msg is "ordered:abc")
        Error(_) => assert(false)
    }
}
// ANCHOR_END: logic
// ANCHOR_END: concepts
