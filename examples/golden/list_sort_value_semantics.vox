// ---
// title: "List sort value-semantics"
// description: "sort_by_key / sort_by are value-semantic (return a NEW sorted list); covers the reassign idiom xs = xs.sort_by_key(f) and reverse, across interp and codegen-rust."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, lambda, sort_by_key, sort_by, reverse, list, let, assign, @test, assert]
// last_validated: 2026-06-07
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Show that Vox list sort_by_key/sort_by return a new list (value semantics), including the xs = xs.sort_by_key(f) reassignment idiom.

// `sort_by_key` returns a NEW list; the original binding is untouched.
@test
fn test_sort_by_key_is_value_semantic() to Unit {
    let nums = [3, 1, 2]
    let asc = nums.sort_by_key(fn(x: int) to int { x })
    assert(asc is [1, 2, 3])
    // Original list unchanged — value semantics, not in-place.
    assert(nums is [3, 1, 2])
}

// The reassignment idiom `xs = xs.sort_by_key(f)` rebinds xs to the sorted list.
@test
fn test_sort_by_key_reassign() to Unit {
    let mut xs = [5, 2, 8, 1]
    xs = xs.sort_by_key(fn(x: int) to int { 0 - x })
    assert(xs is [8, 5, 2, 1])
}

// `sort_by` sorts with a comparator fn(a, b) -> int (<0 / 0 / >0).
@test
fn test_sort_by_comparator() to Unit {
    let xs = [2, 1, 3]
    let sorted = xs.sort_by(fn(a: int, b: int) to int { a - b })
    assert(sorted is [1, 2, 3])
}

// `reverse` stays an in-place-safe mutator (still correct after narrowing).
@test
fn test_reverse_reassign() to Unit {
    let mut xs = [1, 2, 3]
    xs = xs.reverse()
    assert(xs is [3, 2, 1])
}

// EXPECT: ok
fn main() to str {
    test_sort_by_key_is_value_semantic()
    test_sort_by_key_reassign()
    test_sort_by_comparator()
    test_reverse_reassign()
    return "ok"
}
