// ---
// title: "DB Native IR Example"
// description: "Demonstrating db.Table operations: all(), get(), insert(), and len() aggregation."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [@table, @query, db]
// last_validated: 2026-05-13
// training_eligible: true
// training_weight: 1.0
// ---
// Note: Advanced query chaining (where/using/live/scope/order_by/limit/select) is planned
// for a future release. Current supported ops: all(), get(id), insert({...}).

@table type SessionEvent {
    sessionid: str
    source: str
    latencyms: int
    ok: bool
}

@query
fn hot_session_count() to int {
    // Retrieve all session events; filtering is done application-side
    let rows = db.SessionEvent.all()
    return len(rows)
}

@query
fn session_count() to int {
    return len(db.SessionEvent.all())
}
