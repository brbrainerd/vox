// ---
// @training_prompt: Combine @table Post, a list @query, an @mutation, and a small routes tree for a tutorial-style blog slice.

@table type Post {
    title: str
}

@query fn list_posts() to int {
    // Returns count of posts; db.Post.all() returns list internally
    return len(db.Post.all())
}

@mutation fn publish_post(title: str) to Result[str] {
    db.Post.insert({ title: title })?
    return Ok("published")
}

component BlogHome() {
    state n: int = 0
    view: column() {
        text() { "blog" }
        link(href="/edit") { "Edit posts" }
    }
}

component PostEditor() {
    state n: int = 0
    view: text() { "editor" }
}

routes {
    "/" to BlogHome
    "/edit" to PostEditor
}
