// title: "Blog fullstack golden"
// description: "Minimal blog-shaped module: @table Post, @query list, @mutation publish, routes — exercises vox-client GET+POST with manifest."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [@table, @query, @mutation, routes, component]
// last_validated: 2026-05-13
// training_eligible: true
