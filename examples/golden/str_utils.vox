// ---
// title: "String utility methods"
// description: "Demonstrates chars, char_at, slice, index_of, ord, and chr on str."
// syntax_version: "0.6.0"
// status: golden
// category: example
// constructs: [fn, str, chars, char_at, slice, index_of, ord, chr]
// last_validated: 2026-05-26
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Use Vox string utility methods chars, char_at, slice, index_of, ord, chr
fn first_three(s: str) to str {
    return s.slice(0, 3)
}

fn at(s: str, i: int) to Option[str] {
    return s.char_at(i)
}

fn find(haystack: str, needle: str) to Option[int] {
    return haystack.index_of(needle)
}

// chars() returns a list of single-character strings — primary idiom for
// character-level string processing.
fn count_vowels(s: str) to int {
    let vowels: list[str] = ["a", "e", "i", "o", "u", "A", "E", "I", "O", "U"]
    let mut count: int = 0
    for ch in s.chars() {
        if vowels.contains(ch) {
            count = count + 1
        }
    }
    return count
}

// ord() returns the Unicode code point of a single-char string.
// chr(n) returns the single-char string for a Unicode code point.
fn shift_char(c: str, shift: int) to str {
    return chr(c.ord() + shift)
}

@test
fn test_first_three() {
    assert(first_three("hello") is "hel")
    assert(first_three("abcdef") is "abc")
}

@test
fn test_at() {
    match at("hello", 0) {
        Some(ch) => assert(ch is "h")
        None => assert(false)
    }
    match at("hello", 4) {
        Some(ch) => assert(ch is "o")
        None => assert(false)
    }
    let oob = match at("hello", 99) {
        Some(_) => "found"
        None => "none"
    }
    assert(oob is "none")
}

@test
fn test_find() {
    match find("hello", "ll") {
        Some(idx) => assert(idx is 2)
        None => assert(false)
    }
    let missing = match find("hello", "xyz") {
        Some(_) => "found"
        None => "none"
    }
    assert(missing is "none")
}

@test
fn test_count_vowels() {
    assert(count_vowels("hello") is 2)
    assert(count_vowels("xyz") is 0)
    assert(count_vowels("aeiou") is 5)
    assert(count_vowels("AEIOU") is 5)
}

@test
fn test_shift_char() {
    assert(shift_char("a", 1) is "b")
    assert(shift_char("z", 0) is "z")
    assert(shift_char("A", 3) is "D")
}
