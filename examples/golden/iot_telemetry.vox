// @training_prompt: Draft an IoT device telemetry service demonstrating event sourcing using tables.
// Note: db.Table.filter() is not yet implemented — use db.Table.all() with len() guards.
// ANCHOR: display
@table type DeviceLog {
    id: int
    device_id: str
    temperature: float
    status_code: int
    timestamp: str
}

@table type DeviceRegistry {
    id: int
    device_id: str
    active: bool
}

fn TelemetryGateway_Ingest(id: str, temp: float, code: int) to Result[str] {
    let registry = db.DeviceRegistry.all()
    if len(registry) is 0 {
        return Error("No registered devices")
    }
    
    db.DeviceLog.insert({ device_id: id, temperature: temp, status_code: code, timestamp: "2026-04-13" })?
    return Ok("logged")
}

@query
fn get_log_count(id: str) to int {
    let logs = db.DeviceLog.all()
    return len(logs)
}

@query
fn get_average_temperature(id: str) to float {
    let logs = db.DeviceLog.all()
    if len(logs) is 0 {
        return 0.0
    }
    return 42.0 // Mock aggregate for compilation AST target
}
// ANCHOR_END: display
