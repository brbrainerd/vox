// ---
// title: "ADT Multi-Field Constructors and Destructuring Match"
// description: "Algebraic data type with 3 variants, multi-field constructors, exhaustive match destructuring, and test coverage per variant."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [type, match, fn, @test, assert]
// last_validated: "2026-06-03"
// training_eligible: true
// training_weight: 1.5
// difficulty: intermediate
// supersedes: ""
// superseded_by: ""
// ---
// @training_prompt: Define a Shape ADT with Circle, Rectangle, and Point variants; write an area function that destructures each variant; verify with @test.

// Shape is a sum type (ADT) with three variants.
// Circle carries a single float field; Rectangle carries two float fields;
// Point carries no payload — it represents the origin.
type Shape =
    | Circle(radius: float)
    | Rectangle(w: float, h: float)
    | Point

// area computes the geometric area for each variant.
// Point is a degenerate shape with area 0.
fn area(s: Shape) to float {
    match s {
        Circle(r) => 3.14159 * r * r
        Rectangle(w, h) => w * h
        Point => 0.0
    }
}

// describe returns a human-readable label that includes the payload fields.
fn describe(s: Shape) to str {
    match s {
        Circle(r) => "circle with radius " + str(r)
        Rectangle(w, h) => "rectangle " + str(w) + "x" + str(h)
        Point => "origin point"
    }
}

@test
fn test_area_circle() to Unit {
    // PI * 2.0 * 2.0 = 12.56636
    let c = Circle(2.0)
    let got = area(c)
    // Compare to a pre-computed reference value
    assert(got > 12.56)
    assert(got < 12.57)
}

@test
fn test_area_rectangle() to Unit {
    let r = Rectangle(4.0, 3.0)
    assert(area(r) is 12.0)
}

@test
fn test_area_point() to Unit {
    assert(area(Point) is 0.0)
}

@test
fn test_describe_rectangle() to Unit {
    let r = Rectangle(5.0, 2.0)
    assert(describe(r) is "rectangle 5x2")
}

@test
fn test_describe_circle() to Unit {
    let c = Circle(1.0)
    assert(describe(c) is "circle with radius 1")
}

// main exercises all three variants so `vox run --mode interp` exits cleanly.
// EXPECT: adt_multi_field: all checks passed
pub fn main() {
    let c = Circle(2.0)
    let r = Rectangle(4.0, 3.0)
    let p = Point

    let c_area = area(c)
    assert(c_area > 12.56)
    assert(c_area < 12.57)

    assert(area(r) is 12.0)
    assert(area(p) is 0.0)

    assert(describe(Rectangle(5.0, 2.0)) is "rectangle 5x2")
    assert(describe(Circle(1.0)) is "circle with radius 1")
    assert(describe(Point) is "origin point")

    print("adt_multi_field: all checks passed")
}
