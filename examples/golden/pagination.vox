// ---
// @training_prompt: Implement cursor-based pagination over database tables.
// Note: db.Table.filter() is not yet implemented — use db.Table.all() with application-side pagination.
// ANCHOR: display
@table type EventLog {
    timestamp: int
    event_type: str
    payload: str
}

@query
fn event_count() to int {
    return len(db.EventLog.all())
}

@query
fn fetch_events(max_results: int) to int {
    // Returns total event count; client handles pagination
    let results = db.EventLog.all()
    return len(results)
}
// ANCHOR_END: display
