// @training_prompt: Implement cursor-based pagination and filtering over database tables.
// ANCHOR: display
@table type EventLog {
    id: int
    timestamp: int
    event_type: str
    payload: str
}

@endpoint(kind: query)
fn fetch_events(since_ts: int, evt_type: str, max_results: int) to Result[List[EventLog]] {
    // A mock representing a cursor query with filtering and limits
    let results = db.EventLog.filter({ event_type: evt_type })?
    return Ok(results)
}
// ANCHOR_END: display
