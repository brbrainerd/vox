// ---
// title: "While Loops and Infinite Loop+Break Patterns"
// description: "Accumulator algorithms with while, infinite loop+break for search, and value-equality @test coverage."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, while, loop, break, let, assert, @test]
// last_validated: "2026-06-03"
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Demonstrate Vox while loops for accumulator algorithms and loop+break for value search.

// Collatz sequence: count steps from n to reach 1.
// Each step: if n is even divide by 2, otherwise multiply by 3 and add 1.
fn collatz_steps(n: int) to int {
    let mut current = n
    let mut steps = 0
    while current isnt 1 {
        if current % 2 is 0 {
            current = current / 2
        } else {
            current = current * 3 + 1
        }
        steps = steps + 1
    }
    return steps
}

// Power-of-2 accumulation: sum all powers of 2 up to and including 2^limit.
// Returns 2^0 + 2^1 + ... + 2^limit = 2^(limit+1) - 1.
fn sum_powers_of_two(limit: int) to int {
    let mut total = 0
    let mut power = 1
    let mut exp = 0
    while exp <= limit {
        total = total + power
        power = power * 2
        exp = exp + 1
    }
    return total
}

// Search a list for the first value greater than a threshold.
// Returns -1 if no such value exists.
fn first_above(values: list[int], threshold: int) to int {
    let mut idx = 0
    loop {
        if idx >= len(values) {
            return -1
        }
        match values[idx] {
            Some(v) => {
                if v > threshold {
                    return v
                }
            }
            None => { return -1 }
        }
        idx = idx + 1
    }
}

@test
fn test_collatz_known_values() to Unit {
    // collatz(1) = 0 steps (already at 1)
    assert(collatz_steps(1) is 0)
    // collatz(2) = 1 step: 2 -> 1
    assert(collatz_steps(2) is 1)
    // collatz(6) = 8 steps: 6->3->10->5->16->8->4->2->1
    assert(collatz_steps(6) is 8)
    // collatz(27) is well-known: 111 steps
    assert(collatz_steps(27) is 111)
}

@test
fn test_sum_powers_and_search() to Unit {
    // 2^0 + 2^1 + 2^2 = 1 + 2 + 4 = 7
    assert(sum_powers_of_two(2) is 7)
    // 2^0 .. 2^4 = 1+2+4+8+16 = 31
    assert(sum_powers_of_two(4) is 31)
    // search: first value above 5 in [1, 3, 5, 7, 9] is 7
    assert(first_above([1, 3, 5, 7, 9], 5) is 7)
    // search: no value above 100 returns -1
    assert(first_above([1, 3, 5], 100) is -1)
}

fn assert(cond: bool) {
    if not cond {
        panic("Assertion failed")
    }
}

pub fn main() {
    assert(collatz_steps(1) is 0)
    assert(collatz_steps(6) is 8)
    assert(collatz_steps(27) is 111)
    assert(sum_powers_of_two(2) is 7)
    assert(sum_powers_of_two(4) is 31)
    assert(first_above([1, 3, 5, 7, 9], 5) is 7)
    assert(first_above([1, 3, 5], 100) is -1)
    print("All while/loop assertions passed")
}
