// ---
// title: "String Interpolation and Method Chaining"
// description: "Template string interpolation with scalar types, multi-part interpolation in loops, and str method chaining: split, trim, to_upper, replace, contains."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, str, interpolation, split, trim, to_upper, replace, contains, for, @test]
// last_validated: "2026-06-03"
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Use Vox string interpolation with scalars and chain str methods: split, trim, to_upper, replace, contains.

// Interpolation only supports simple identifier expressions inside {}.
// Convert ints, floats, and bools to str first, then embed them.
fn greet(name: str, score: int, passed: bool) to str {
    let score_s = str(score)
    let passed_s = str(passed)
    return "Hello {name}! Score: {score_s}. Passed: {passed_s}."
}

// Float interpolation: convert to str before embedding.
fn format_price(label: str, amount: float) to str {
    let amount_s = str(amount)
    return "Item: {label}, Price: {amount_s}"
}

// Multi-part interpolation in a loop body.
fn build_index(items: list[str]) to list[str] {
    let mut lines: list[str] = []
    let mut i: int = 0
    for item in items {
        let i_s = str(i)
        let line = "{i_s}: {item}"
        lines = lines.push(line)
        i = i + 1
    }
    return lines
}

// String method chaining: split -> iterate, trim, to_upper, replace, contains.
fn normalize_tags(raw: str) to list[str] {
    let parts = raw.split(",")
    let mut result: list[str] = []
    for part in parts {
        let cleaned = part.trim().to_upper().replace("-", "_")
        result = result.push(cleaned)
    }
    return result
}

fn has_keyword(sentence: str, word: str) to bool {
    return sentence.to_upper().contains(word.to_upper())
}

fn main() to Unit {
    let msg = greet("Alice", 95, true)
    assert(msg is "Hello Alice! Score: 95. Passed: true.")
    let tags = normalize_tags("  rust , go , web-dev ")
    assert(tags.get(0) is Some("RUST"))
    assert(tags.get(2) is Some("WEB_DEV"))
    assert(has_keyword("Welcome to Vox", "VOX") is true)
    let lines = build_index(["alpha", "beta"])
    assert(lines.get(0) is Some("0: alpha"))
    assert(lines.get(1) is Some("1: beta"))
    let price = format_price("widget", 3.5)
    assert(price is "Item: widget, Price: 3.5")
    print("All string interpolation checks passed.")
}

@test
fn test_greet_interpolation() to Unit {
    let msg = greet("Alice", 95, true)
    assert(msg is "Hello Alice! Score: 95. Passed: true.")
}

@test
fn test_normalize_tags() to Unit {
    let tags = normalize_tags("  rust , go , web-dev ")
    assert(tags.get(0) is Some("RUST"))
    assert(tags.get(1) is Some("GO"))
    assert(tags.get(2) is Some("WEB_DEV"))
}
