// ANCHOR: basic_agent
// Note: The agent construct is tombstoned. Use standard functions and MCP skills instead.
fn assistant_greet(name: str) to str {
    return "Hello " + name + ", how can I assist you today?"
}
// ANCHOR_END: basic_agent

// ANCHOR: stateful_agent
@table type MemoryBank {
    id: int
    entries: List[str]
}
// ANCHOR_END: stateful_agent
