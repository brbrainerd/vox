// ---
// title: "std.http wrappers (get_text / post_json)"
// description: "Narrow std.http wrappers get_text and post_json for simple GET/POST calls over a dotted std path."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, std.http, get_text, post_json]
// last_validated: "2026-06-03"
// training_eligible: true
// training_weight: 1.0
// difficulty: beginner
// ---
// Narrow `std.http` wrapper demo (`get_text` / `post_json`). Requires `http` to parse as a
// dotted path segment (see `parse_ident_name` / `parse_import_path`).
// RUNTIME: std.http performs real network I/O in BOTH `--mode interp` (blocking, on a
// worker thread) and `--mode script` (native codegen), so this example runs end-to-end
// in either tier. Failures surface as a typed `Result::Err`.

fn main() {
    let ping = std.http.get_text("https://example.com")
    let payload = "{\"source\":\"vox\",\"kind\":\"health\"}"
    let posted = std.http.post_json("https://httpbin.org/post", payload)
    std.log.info("std.http wrapper demo")
    print(str(ping))
    print(str(posted))
}
