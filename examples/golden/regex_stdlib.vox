// difficulty: intermediate
// ---
// @training_prompt: Use std.regex to compile a pattern and extract a capture group
fn extract_mood(transcript: str) to Option[str] {
    let compiled = std.regex.compile("(?:mood|feeling).*?(\\d)")
    return match compiled {
        Ok(re) => match re.find(transcript) {
            Some(m) => m.group(1)
            None => None
        }
        Error(_) => None
    }
}

fn is_phone(s: str) to bool {
    let compiled = std.regex.compile("^\\d{3}-\\d{4}$")
    return match compiled {
        Ok(re) => re.matches(s)
        Error(_) => false
    }
}

@test
fn test_extract_mood() {
    match extract_mood("my mood was 7 today") {
        Some(d) => assert(d is "7")
        None => assert(false)
    }
    let no_mood = match extract_mood("nothing here") {
        Some(_) => "found"
        None => "none"
    }
    assert(no_mood is "none")
}

@test
fn test_is_phone() {
    assert(is_phone("555-1234") is true)
    assert(is_phone("5551234") is false)
    assert(is_phone("12-3456") is false)
}
