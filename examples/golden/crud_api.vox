// ---
// title: "CRUD API Golden"
// description: "Data layer: @table, @query, @mutation, db.* (canonical surface)."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [@table, @query, @mutation, db, fn]
// last_validated: 2026-05-13
// training_eligible: true
// training_weight: 1.0
// ---
// @training_prompt: Write a minimal CRUD-oriented Vox module: @table, @query, @mutation, one query endpoint, and db.Table operations (get/all, insert).
// ANCHOR: display
@table type User {
    name: str
    active: bool
}

@query
fn user_count() to int {
    return len(db.User.all())
}

@query
fn all_users() to int {
    // Returns count of all users; filter by active is application-side logic
    let users = db.User.all()
    return len(users)
}

@mutation
fn seed_user(name: str) to str {
    db.User.insert({ name: name, active: true })
    return "created"
}

@query fn handler() to int {
    return len(db.User.all())
}
// ANCHOR_END: display

// Behavioral coverage: exercise the db.* surface under `--mode interp` so the
// data layer is verified end-to-end, not just typechecked.
@test fn db_insert_and_query_roundtrip() {
    // Exercise the actual @mutation / @query handlers end-to-end.
    assert(seed_user("ada") is "created")
    assert(seed_user("alan") is "created")
    assert(user_count() is 2)
    assert(all_users() is 2)
    // And the raw db.* surface.
    let id = db.User.insert({ name: "grace", active: true })
    assert(id.unwrap() is 2)
    assert(len(db.User.filter({ active: true })) is 3)
}
