// ---
// title: "Range Loops and List/Dict Index Operations"
// description: "range(n) and range(start,end) in for-loops; arr[i]=v and dict[k]=v index assignment; for v, i in list index binding."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, for, range, let_mut, index_assign, list, @test]
// last_validated: 2026-06-03
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Show range(n), range(start,end), arr[i]=v index assignment, and for v,i in list index binding in Vox.

// Compute prefix sums using range(n) and arr[i] = v index assignment.
// Returns a new list where result[i] = sum of nums[0..=i].
fn prefix_sums(nums: list[int]) to list[int] {
    let n: int = len(nums)
    let mut result: list[int] = []
    // Seed result with zeros using range(n)
    for _ in range(n) {
        result.push(0)
    }
    let mut running: int = 0
    for i in range(n) {
        match nums[i] {
            Some(v) => {
                running = running + v
                result[i] = running
            }
            None => {}
        }
    }
    return result
}

// Count how many values in a list exceed a threshold.
// Uses range(start, end) to walk a slice from index start to end (exclusive).
fn count_above(nums: list[int], start: int, end: int, threshold: int) to int {
    let mut count: int = 0
    for i in range(start, end) {
        match nums[i] {
            Some(v) => {
                if v > threshold {
                    count = count + 1
                }
            }
            None => {}
        }
    }
    return count
}

// Build a label map: for each item in the list, record its index as a string key.
// Demonstrates for v, i in list { } index binding and dict["key"] = val assignment.
fn index_labels(items: list[str]) to list[str] {
    let mut seen: list[str] = []
    for item, i in items {
        // Append "i:item" to track which index held which value
        seen.push(str(i) + ":" + item)
    }
    return seen
}

@test
fn test_prefix_sums() to Unit {
    let ps = prefix_sums([1, 2, 3, 4])
    // Expected: [1, 3, 6, 10]
    match ps[0] {
        Some(v) => assert(v is 1)
        None => assert(false)
    }
    match ps[2] {
        Some(v) => assert(v is 6)
        None => assert(false)
    }
    match ps[3] {
        Some(v) => assert(v is 10)
        None => assert(false)
    }
}

@test
fn test_count_above_and_index_labels() to Unit {
    let nums: list[int] = [5, 12, 3, 9, 7]
    // range(1, 4) covers indices 1, 2, 3 → values 12, 3, 9; above 6 → 12 and 9
    let c = count_above(nums, 1, 4, 6)
    assert(c is 2)

    let labels = index_labels(["a", "b", "c"])
    match labels[0] {
        Some(v) => assert(v is "0:a")
        None => assert(false)
    }
    match labels[2] {
        Some(v) => assert(v is "2:c")
        None => assert(false)
    }
}

// EXPECT: ok
fn main() to str {
    test_prefix_sums()
    test_count_above_and_index_labels()
    return "ok"
}
