// ---
// title: "Reference: MCP Tool and Resource"
// description: "Reference snippet for MCP surface: @mcp.tool and @mcp.resource functions plus an orchestrator config helper replacing tombstoned env."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, @mcp.tool, @mcp.resource]
// last_validated: "2026-06-03"
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// ANCHOR: mcp_tool
@mcp.tool "Calculate the sum of two integers"
fn sum(a: int, b: int) to int {
    return a + b
}
// ANCHOR_END: mcp_tool

// ANCHOR: mcp_resource
@mcp.resource ("notes://recent", "Recent system notes")
fn get_recent_notes() to str {
    return "This is a note from the system."
}
// ANCHOR_END: mcp_resource

// ANCHOR: orchestrator_config
// Note: env constructs are tombstoned. Use Dockerfile or standardized CI pipelines.
fn orchestrator_staging_config() to str {
    return "node:22-alpine"
}
// ANCHOR_END: orchestrator_config
