// ---
// title: "Error Propagation Patterns"
// description: "Result chaining, early return on Error, composing fallible operations."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [Result, Error, Ok, match, fn]
// last_validated: 2026-04-13
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Show Vox error propagation: chained Result operations, early return on Error, and workflow-level error handling.
// ANCHOR: display
fn parse_int(s: str) to Result[int] {
    if len(s) is 0 {
        return Error("empty string")
    }
    return Ok(42)
}

fn divide(a: int, b: int) to Result[int] {
    if b is 0 {
        return Error("division by zero")
    }
    return Ok(a / b)
}

fn handle_numerator(raw_b: str, av: int) to Result[int] {
    let b = parse_int(raw_b)
    match b {
        Error(e) => Error("bad denominator")
        Ok(bv) => divide(av, bv)
    }
}

fn compute(raw_a: str, raw_b: str) to Result[int] {
    let a = parse_int(raw_a)
    match a {
        Error(e) => Error("bad numerator")
        Ok(av) => handle_numerator(raw_b, av)
    }
}

fn validate_email(email: str) to Result[str] {
    if len(email) < 5 {
        return Error("email too short")
    }
    return Ok(email)
}

fn send_welcome(email: str) to Result[Unit] {
    return Ok(Unit)
}

fn proceed_onboarding(addr: str) to Result[str] {
    let sent = send_welcome(addr)
    match sent {
        Error(e) => Error("send failed")
        Ok(ignore) => Ok("onboarded")
    }
}

fn onboard_user(email: str) to Result[str] {
    let valid = validate_email(email)
    match valid {
        Error(e) => Error(e)
        Ok(addr) => proceed_onboarding(addr)
    }
}
// ANCHOR_END: display

@test
fn test_parse_int() {
    match parse_int("42") {
        Ok(n) => assert(n is 42)
        Error(_) => assert(false)
    }
    let empty_result = match parse_int("") {
        Ok(_) => "ok"
        Error(e) => e
    }
    assert(empty_result is "empty string")
}

@test
fn test_divide() {
    match divide(10, 2) {
        Ok(n) => assert(n is 5)
        Error(_) => assert(false)
    }
    let div_zero = match divide(10, 0) {
        Ok(_) => "ok"
        Error(e) => e
    }
    assert(div_zero is "division by zero")
}

@test
fn test_validate_email() {
    match validate_email("user@example.com") {
        Ok(addr) => assert(addr is "user@example.com")
        Error(_) => assert(false)
    }
    let too_short = match validate_email("a@b") {
        Ok(_) => "ok"
        Error(e) => e
    }
    assert(too_short is "email too short")
}

@test
fn test_onboard_user() {
    // Short email fails validation before reaching send_welcome.
    let bad = match onboard_user("no") {
        Ok(_) => "ok"
        Error(e) => e
    }
    assert(bad is "email too short")
    // Valid email flows through validate_email -> proceed_onboarding ->
    // send_welcome (Ok(Unit)) and returns Ok("onboarded").
    let good = match onboard_user("user@example.com") {
        Ok(msg) => msg
        Error(_) => "err"
    }
    assert(good is "onboarded")
}
