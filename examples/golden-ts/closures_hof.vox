// ---
// title: "Closures and Higher-Order Functions"
// description: "Closures capturing outer variables, list.map/filter/fold chains, sorted_by_key, and a function that returns a closure."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, closure, lambda, map, filter, fold, sorted_by_key, list, let, @test, assert]
// last_validated: 2026-06-03
// training_eligible: true
// training_weight: 1.5
// difficulty: intermediate
// ---
// @training_prompt: Write Vox closures that capture outer variables and use list.map, list.filter, list.fold, and sorted_by_key to transform data.

// A closure that captures an outer variable via the enclosing scope.
// `make_adder` returns a fn value; calling it adds `n` to any int.
fn make_adder(n: int) to fn(int) to int {
    return fn(x: int) to int { x + n }
}

// Apply map to scale every element by a multiplier captured from the outer scope.
fn scale_all(nums: list[int], factor: int) to list[int] {
    return nums.map(fn(x: int) to int { x * factor })
}

// Filter to only even numbers, then fold (sum) the survivors.
fn sum_of_evens(nums: list[int]) to int {
    let evens = nums.filter(fn(x: int) to bool { x % 2 is 0 })
    return evens.fold(0, fn(acc: int, x: int) to int { acc + x })
}

// Sort words by their length using sorted_by_key.
fn sort_by_length(words: list[str]) to list[str] {
    return words.sorted_by_key(fn(w: str) to int { len(w) })
}

@test
fn test_make_adder() to Unit {
    let add5 = make_adder(5)
    assert(add5(10) is 15)
    assert(add5(0) is 5)
    assert(add5(-3) is 2)
}

@test
fn test_sum_of_evens() to Unit {
    let nums = [1, 2, 3, 4, 5, 6]
    // evens: [2, 4, 6] -> sum = 12
    assert(sum_of_evens(nums) is 12)
    assert(sum_of_evens([1, 3, 5]) is 0)
}

@test
fn test_scale_and_sort() to Unit {
    let scaled = scale_all([1, 2, 3], 3)
    // [3, 6, 9]
    assert(scaled.fold(0, fn(acc: int, x: int) to int { acc + x }) is 18)

    let words = ["fig", "apple", "kiwi", "plum"]
    let sorted = sort_by_length(words)
    // "fig"(3) < "kiwi"(4)="plum"(4) < "apple"(5)
    assert(sorted.first() is Some("fig"))
}

// EXPECT: ok
fn main() to str {
    test_make_adder()
    test_sum_of_evens()
    test_scale_and_sort()
    return "ok"
}
