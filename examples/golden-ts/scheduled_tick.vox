// @training_prompt: Declare a Vox function that runs every hour using the @scheduled decorator.
// ANCHOR: scheduled_region
// @scheduled("<cadence>") registers the fn with the durable scheduler.
@scheduled("1h")
fn scheduled_tick_1h() to Unit {
    return Unit
}
// ANCHOR_END: scheduled_region
