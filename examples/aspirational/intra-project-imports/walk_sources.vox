// walk_sources.vox — Recursive source walker for MENS corpus harvest.
// Extracts .vox and .rs source files for the mens-lang domain.

fn walk_sources(root: str) -> list[str] {
    let mut files = [];
    let crates_dir = root + "/crates";
    
    if fs.exists(crates_dir) {
        print("walking sources: " + crates_dir);
        // Include .vox for language patterns, .rs for implementation patterns.
        let found_vox = fs.walk(crates_dir, "*.vox");
        let found_rs = fs.walk(crates_dir, "*.rs");
        
        // Skip ignored directories (e.g., target, node_modules) handled by fs.walk automatically
        // if it respects .gitignore, or we filter manually.
        files = found_vox + found_rs;
    }
    
    files
}

module.exports = walk_sources;
