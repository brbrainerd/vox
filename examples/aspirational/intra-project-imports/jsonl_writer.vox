// jsonl_writer.vox — Buffered JSONL writer for large corpus staging.

fn write_jsonl(path: str, entries: list[object]) -> bool {
    let mut success = true;
    let mut content = "";
    
    for entry in entries {
        content = content + json.stringify(entry) + "\n";
    }
    
    if fs.write(path, content) {
        print("wrote " + entries.len() + " entries to " + path);
    } else {
        print("failed to write to " + path);
        success = false;
    }
    
    success
}

module.exports = write_jsonl;
