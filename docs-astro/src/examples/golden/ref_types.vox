// ANCHOR: scalar
fn demo_scalars() {
    let i: int = 42
    let f: float = 3.14
    let s: str = "hello"
    let b: bool = true
    // Char is a v1.x type — until then a single-char string carries
    // the semantic. Tracked in the v1.0 completion plan as P2.6.
    let c: str = "x"
}
// ANCHOR_END: scalar

// ANCHOR: collections
fn demo_collections() {
    let nums: List[int] = [1, 2, 3]
    let mapping: Map[str, int] = {a: 1, b: 2}
}
// ANCHOR_END: collections

// ANCHOR: adt
type NetworkState = 
    | Disconnected
    | Connecting
    | Connected(address: str, port: int)
// ANCHOR_END: adt

// ANCHOR: matching
fn handle_state(net_state: NetworkState) {
    match net_state {
        Disconnected => print("offline")
        Connecting => print("connecting...")
        Connected(address, port) => print("connected to " + address)
    }
}
// ANCHOR_END: matching
