// ANCHOR: display
// Minimal notify demo — same handler shape as `examples/golden/mobile_camera.vox`.

import std.mobile

component App() {
    view: button(on_click={fn() { mobile.notify("Hello", "From Vox!") }}) {
        "Notify Me"
    }
}
// ANCHOR_END: display
