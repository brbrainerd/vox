// ---
// title: "Process execution: std.process.run and run_capture"
// description: "Spawn subprocesses argv-first; run returns Option, run_capture returns Result. Guard null before reading fields."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [fn, std.process, run, run_capture, Option, Result, match, @test, assert]
// last_validated: 2026-06-03
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Use std.process.run for fire-and-inspect and std.process.run_capture for structured stdout capture; always guard the Option before accessing fields.

// std.process.run returns Option[{code, stdout, stderr}].
// None means the binary could not be spawned; Some means it ran (any exit code).
fn run_and_get_code(cmd: str, args: list[str]) to int {
    let result = std.process.run(cmd, args)
    if result isnt null {
        let r = result.unwrap()
        return r.code
    }
    return -1
}

// std.process.run_capture returns Result[{exit, stdout, stderr}].
// Use a match to guard against spawn errors before reading captured output.
fn capture_stdout(cmd: str, args: list[str]) to str {
    let result = std.process.run_capture(cmd, args)
    match result {
        Ok(r) => r.stdout
        Error(_) => ""
    }
}

fn main() to Unit {
    // Demonstrate std.process.run with the guard-with-is-null pattern.
    let result = std.process.run("cargo", ["--version"])
    if result isnt null {
        let r = result.unwrap()
        print("cargo exit code: " + str(r.code))
    }
}

@test
fn run_known_command_returns_option_some() to Unit {
    // cargo is always on PATH in this project; a successful spawn returns Some.
    let result = std.process.run("cargo", ["--version"])
    assert(result isnt null)
}

@test
fn run_exit_code_is_zero_for_version_flag() to Unit {
    let code = run_and_get_code("cargo", ["--version"])
    assert(code is 0)
}
