// ---
// title: "Layered overlay golden"
// description: "Canonical 'how to do overlap correctly' sample — @layer(tier:) chrome shell, a content panel, and a modal hosted in an overlay portal. Exercises GA-26 tiers with zero contrast/occlusion violations. Positive counterpart to examples/forbidden/."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [component, @layer, view, overlay, modal, toast]
// last_validated: 2026-06-12
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Build a small app shell with a chrome-tier top bar, a readable content panel, and a modal hosted in an overlay — using VUV tiers so occlusion and contrast are correct by construction.

@layer(tier: chrome)
component TopBar() {
    state n: int = 0
    view: row(bg="zinc.900", pad="4", justify="between") {
        text(color="zinc.50", weight="bold") { "Vox App" }
        text(color="zinc.300") { "Settings" }
    }
}

component App() {
    state show: bool = false
    view: column(gap="4") {
        TopBar()
        panel(bg="white", pad="6") {
            text(color="zinc.900") { "Readable body content on a light surface." }
        }
        overlay() {
            modal(bg="white", pad="6") {
                text(color="zinc.900", weight="bold") { "Confirm action?" }
            }
            toast(bg="zinc.900") {
                text(color="zinc.50") { "Saved." }
            }
        }
    }
}
