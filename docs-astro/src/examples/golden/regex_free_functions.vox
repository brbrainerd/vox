// ---
// title: "Regex free-function API (regex.is_match / replace / captures)"
// description: "Cross-tier-safe regex free functions work under both --mode interp and --mode script without a compiled-object handle."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [regex, regex.is_match, regex.replace, regex.captures, Option, match, fn, @test]
// last_validated: 2026-06-03
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Use the regex free-function API (regex.is_match, regex.replace, regex.captures) that works under both --mode interp and --mode script

// regex.is_match(text, pattern) -> bool
// Returns true if the pattern matches anywhere in the text.
fn is_valid_email(s: str) to bool {
    return regex.is_match(s, "^[\\w.+-]+@[\\w-]+\\.[a-z]{2,}$")
}

// regex.replace(text, pattern, replacement) -> str
// Replaces ALL occurrences matching the pattern (equivalent to replace_all).
fn redact_digits(s: str) to str {
    return regex.replace(s, "\\d+", "***")
}

// regex.captures(text, pattern) -> Option[list[str]]
// Returns Some with the full match at index 0 and capture groups at 1+, or None if no match.
// List subscript returns Option[str], so each group is unwrapped via match.
fn extract_version(s: str) to Option[str] {
    let result = regex.captures(s, "v(\\d+)\\.(\\d+)\\.(\\d+)")
    return match result {
        Some(groups) => {
            let major = match groups[1] { Some(v) => v  None => "" }
            let minor = match groups[2] { Some(v) => v  None => "" }
            let patch = match groups[3] { Some(v) => v  None => "" }
            Some(major + "." + minor + "." + patch)
        }
        None => None
    }
}

// EXPECT: email valid: true
// EXPECT: redacted: card ***-***-***-*** expires ***/***
// EXPECT: version: 1.23.4
fn main() {
    // Demonstrate all three free-function entry points.
    let matched = regex.is_match("user@example.com", "^[\\w.+-]+@[\\w-]+\\.[a-z]{2,}$")
    print("email valid: " + str(matched))

    let clean = redact_digits("card 4111-1111-1111-1111 expires 12/26")
    print("redacted: " + clean)

    let ver = extract_version("sdk v1.23.4 released")
    match ver {
        Some(v) => print("version: " + v)
        None => print("no version found")
    }
}

@test
fn test_is_match() to Unit {
    assert(regex.is_match("hello world", "\\bworld\\b") is true)
    assert(regex.is_match("hello world", "^world") is false)
    assert(is_valid_email("user@example.com") is true)
    assert(is_valid_email("not-an-email") is false)
}

@test
fn test_replace_and_captures() to Unit {
    let redacted = redact_digits("order 42 of 7 items")
    assert(redacted is "order *** of *** items")

    // Match on the Option (idiomatic) rather than comparing against a
    // Some/None literal with `is`.
    match extract_version("release v2.14.0 is live") {
        Some(v) => assert(v is "2.14.0")
        None => assert(false)
    }

    // A string with no version yields None; verify the None path by mapping it
    // through a fallback (a real observable, not a tautological `assert(true)`).
    let fallback = match extract_version("no version here") {
        Some(v) => v
        None => "none"
    }
    assert(fallback is "none")
}
