// emit_diagnostics.vox — Diagnostic extractor for negative training examples.
// Collects compiler errors and lints to train MENS on what NOT to do.

fn extract_diagnostics(root: str) -> list[object] {
    let mut entries = [];
    let audit_dir = root + "/.vox/audit/latest";
    
    if fs.exists(audit_dir) {
        let files = fs.walk(audit_dir, "diagnostics.json");
        for f in files {
            let content = fs.read(f);
            if let Ok(parsed) = json.parse(content) {
                // Map diagnostic to a training pair format
                // In a real implementation, we would extract the offending code snippet
                // and the error message as a "negative" sample.
                entries.push({
                    "source": f,
                    "count": parsed.length(),
                    "type": "diagnostic"
                });
            }
        }
    }
    
    entries
}

module.exports = extract_diagnostics;
