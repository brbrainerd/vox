// ---
// title: "JSON parse + access (std.json, strict-Option API)"
// description: "Parse a JSON string and walk the resulting Json value with the strict-Option API (RFC 2026-05-23)."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [std.json, json, get, pointer, as_str, as_int, has]
// last_validated: 2026-05-23
// training_eligible: true
// training_weight: 1.0
// difficulty: intermediate
// ---
// @training_prompt: Use std.json.parse and chainable Option-returning accessors to read fields from a JSON string

// CANONICAL FORM — get + and_then + as_X at the leaf.
// This is the recommended idiom for shallow access.
fn read_kind(payload_json: str) to Option[str] {
    return match std.json.parse(payload_json) {
        Ok(data) => data.get("kind").and_then(fn(j: Json) to Option[str] { j.as_str() })
        Error(_) => None
    }
}

// CANONICAL FORM (deep paths) — pointer + and_then + as_X.
// `pointer` collapses N-hop chains to a single RFC 6901 path string.
fn read_mood_score(payload_json: str) to Option[int] {
    return match std.json.parse(payload_json) {
        Ok(data) => data.pointer("/payload/mood_score").and_then(fn(j: Json) to Option[int] { j.as_int() })
        Error(_) => None
    }
}

// CANONICAL FORM (membership check) — has() returns bool, no Option wrap.
fn has_payload(payload_json: str) to bool {
    return match std.json.parse(payload_json) {
        Ok(data) => data.has("payload")
        Error(_) => false
    }
}

@test
fn test_read_kind() {
    let json_with_kind = "{\"kind\":\"event\",\"payload\":{\"mood_score\":7}}"
    match read_kind(json_with_kind) {
        Some(k) => assert(k is "event")
        None => assert(false)
    }
    let missing = match read_kind("{\"other\":\"field\"}") {
        Some(_) => "found"
        None => "none"
    }
    assert(missing is "none")
    let bad = match read_kind("not json") {
        Some(_) => "found"
        None => "none"
    }
    assert(bad is "none")
}

@test
fn test_read_mood_score() {
    let json_with_score = "{\"kind\":\"event\",\"payload\":{\"mood_score\":7}}"
    match read_mood_score(json_with_score) {
        Some(n) => assert(n is 7)
        None => assert(false)
    }
    let no_score = match read_mood_score("{\"kind\":\"event\"}") {
        Some(_) => "found"
        None => "none"
    }
    assert(no_score is "none")
}

@test
fn test_has_payload() {
    let with_payload = "{\"kind\":\"event\",\"payload\":{\"mood_score\":7}}"
    assert(has_payload(with_payload) is true)
    assert(has_payload("{\"kind\":\"event\"}") is false)
    assert(has_payload("bad json") is false)
}
