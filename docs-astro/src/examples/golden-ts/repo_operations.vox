// ---
// title: "Repository Operations Golden"
// description: "End-to-end repo.* surface: snapshot, changes, undo — each verified by @test under --mode interp with uses vcs declared."
// syntax_version: "0.5.0"
// status: golden
// category: example
// constructs: [@test, repo, fn, uses vcs]
// last_validated: 2026-06-06
// training_eligible: true
// training_weight: 1.0
// ---
// @training_prompt: Demonstrate the Vox VCS surface — repo.snapshot(label) returning a monotonic change id, repo.changes() returning the full change list, and repo.undo() removing the latest snapshot — with @test functions under `uses vcs` that assert observable behavior.

// ─────────────────────────────────────────────────────────────────────────────
// 1. Snapshot / changes / undo lifecycle.
//    repo.snapshot(label) returns a monotonic id (0-based).
//    repo.changes() returns the full list of recorded change ids.
//    repo.undo() pops the latest snapshot and returns its id.
// ─────────────────────────────────────────────────────────────────────────────
@test fn snapshot_undo_lifecycle() uses vcs {
    // First snapshot gets id 0, second gets id 1.
    assert(repo.snapshot("first") is 0)
    assert(repo.snapshot("second") is 1)

    // Both changes are visible.
    assert(len(repo.changes()) is 2)

    // undo pops the latest (id 1) and returns it.
    assert(repo.undo() is 1)

    // Only one change remains.
    assert(len(repo.changes()) is 1)
}
