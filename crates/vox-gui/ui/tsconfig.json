{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,

    // Intentionally lenient: this codebase predates any typecheck. Goal is to catch the
    // high-value class of bugs (missing properties / undefined components / wrong imports
    // — e.g. the Icon.plus crash that blanked the app) without drowning in existing `any`.
    // Tighten incrementally.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/claude-dashboard"]
}
