{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox",
  "version": "0.6.0",
  "identifier": "org.vox-foundation.gui",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Axis",
        "width": 1280,
        "height": 800,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "app", "appimage", "deb"],
    "publisher": "Vox Foundation",
    "category": "DeveloperTool",
    "shortDescription": "Axis — the Vox desktop shell",
    "longDescription": "Axis is the Vox desktop application: editor, agent harness, and language toolchain in one window.",
    "homepage": "https://voxlang.org",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["vox"],
        "name": "Vox Source",
        "description": "Vox source file",
        "role": "Editor",
        "mimeType": "text/x-vox",
        "exportedType": {
          "identifier": "org.vox-foundation.vox-source",
          "conformsTo": ["public.source-code", "public.plain-text"]
        }
      }
    ],
    "externalBin": [
      "../../target/release/vox"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {}
  }
}
