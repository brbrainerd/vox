#[derive(Embed)]
#[folder = "public/"]
struct Assets;

async fn serve_embedded(uri: axum::http::Uri) -> Response {
    let path = uri.path().trim_start_matches('/');
    let path = if path.is_empty() { "index.html" } else { path };
    match Assets::get(path) {
        Some(file) => {
            let mime = mime_guess::from_path(path).first_or_octet_stream();
            (StatusCode::OK, [(header::CONTENT_TYPE, mime.as_ref().to_string())], file.data.to_vec()).into_response()
        }
        None => {
            // SPA fallback: serve index.html for client-side routing
            match Assets::get("index.html") {
                Some(file) => (StatusCode::OK, [(header::CONTENT_TYPE, "text/html".to_string())], file.data.to_vec()).into_response(),
                None => (StatusCode::NOT_FOUND, "Not Found").into_response(),
            }
        }
    }
}

async fn serve_dispatch(req: axum::http::Request<Body>) -> Response {
    let uri = req.uri().clone();
    if *req.method() == axum::http::Method::GET {
        if let Ok(base) = std::env::var("VOX_SSR_DEV_URL") {
            let base = base.trim();
            if !base.is_empty() {
                let p = uri.path();
                if !p.starts_with("/api") {
                    let target = format!("{}{}", base.trim_end_matches('/'), uri);
                    if let Ok(client) = vox_http_client::client_builder()
                        .timeout(std::time::Duration::from_secs(60))
                        .build()
                    {
                        if let Ok(resp) = client.get(target).send().await {
                            let status = resp.status();
                            let ct = resp.headers().get(reqwest::header::CONTENT_TYPE).cloned();
                            let bytes = resp.bytes().await.unwrap_or_default();
                            let code = axum::http::StatusCode::from_u16(status.as_u16())
                                .unwrap_or(axum::http::StatusCode::BAD_GATEWAY);
                            let mut builder = Response::builder().status(code);
                            if let Some(ct) = ct {
                                if let Ok(v) = ct.to_str() {
                                    builder = builder.header(header::CONTENT_TYPE, v);
                                }
                            }
                            if let Ok(out) = builder.body(Body::from(bytes)) {
                                return out;
                            }
                        }
                    }
                }
            }
        }
    }
    serve_embedded(uri).await
}

async fn vox_copy_request_id(mut req: axum::http::Request<Body>, next: middleware::Next) -> Response {
    let rid = req.extensions().get::<tower_http::request_id::RequestId>().and_then(|id| id.header_value().to_str().ok().map(|s| s.to_string()));
    req.extensions_mut().insert(rid);
    next.run(req).await
}

#[tokio::main]
async fn main() {
    tracing_subscriber::fmt::init();
    // 1. Initialize the durable database.
    //    Uses `DbConfig::resolve_canonical()` so the binary picks up
    //    `VOX_DB_URL`/`VOX_DB_PATH` env vars (matches `emit_db_setup`).
    let vox_durable_db = std::sync::Arc::new(::vox_db::VoxDb::connect(
        ::vox_db::DbConfig::resolve_canonical()
            .expect("vox durable boot: resolve VoxDb config (VOX_DB_URL+TOKEN, or VOX_DB_PATH)"),
    ).await.expect("vox durable boot: VoxDb::connect"));

    // 2. Register the process-global HirModule for workflow body lookup.
    //    The HirModule is serialized to JSON at codegen time and embedded
    //    as a `const &str` (see `load_hir_module_from_embedded` below).
    ::vox_workflow_runtime::workflow::set_current_hir_module(
        load_hir_module_from_embedded()
    );

    // 3. No `@scheduled` functions in this module — scheduler not started.

    let mut app = Router::new()
        .route("/api/get_stats", post(handle_sf_get_stats))
        .route("/api/query/api_todos", get(handle_q_api_todos))
        .route("/api/mutation/create_todo", post(handle_m_create_todo))
        .fallback(serve_dispatch);

    app = app.layer(middleware::from_fn(vox_copy_request_id));
    app = app.layer(PropagateRequestIdLayer::x_request_id());
    app = app.layer(SetRequestIdLayer::x_request_id(MakeRequestUuid));
    app = app.layer(TraceLayer::new_for_http());

    let port: u16 = std::env::var("VOX_PORT")
        .ok()
        .and_then(|s| s.parse().ok())
        .unwrap_or(3000);
    let addr = SocketAddr::from(([127, 0, 0, 1], port));
    println!("Listening on {}", addr);
    let listener = match tokio::net::TcpListener::bind(addr).await {
        Ok(listener) => listener,
        Err(e) => { eprintln!("Failed to bind TCP listener: {}", e); std::process::exit(2); }
    };
    if let Err(e) = axum::serve(listener, app.into_make_service_with_connect_info::<SocketAddr>()).await {
        eprintln!("Server exited with error: {}", e);
        std::process::exit(2);
    }
    vox_actor_runtime::builtins::vox_flush_exit_commands();
}

