import React, { useState } from "react";

export function Dashboard(): React.ReactElement {
  const [n, set_n] = useState(0);
  return (
    <div className={["flex", "flex-col", "dash"].filter(Boolean).join(" ")}>
      {n}
    </div>
  );
}
