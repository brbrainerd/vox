import React, { useState } from "react";

export function LoginForm(): React.ReactElement {
    const [email, set_email] = useState("");
  return (
    <div className="px-4">
    <input className={["flex", "h-9", "w-full", "rounded-md", "border", "border-input", "bg-transparent", "px-3", "py-1", "text-sm", "shadow-sm", "focus-visible:outline-none", "focus-visible:ring-1", "focus-visible:ring-ring", "email-field"].filter(Boolean).join(" ")} onChange={(e) => set_email(e.target.value)} value={email} />
    </div>
  );
}
