import React, { useState, useEffect } from "react";

export function Timer(): React.ReactElement {
    const [count, set_count] = useState(0);
    useEffect(((_x) => (count)));
  return (
    <div className="px-4">
    <div className={["flex", "flex-col", "timer"].filter(Boolean).join(" ")}>
      {count}
    </div>
    </div>
  );
}
