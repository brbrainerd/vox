async fn handle_sf_chat(Extension(vox_rid): Extension<Option<String>>, Extension(db): Extension<Arc<Codex>>, Json(request): Json<serde_json::Value>) -> Result<Json<serde_json::Value>, (StatusCode, Json<serde_json::Value>)> {
    let prompt = request["prompt"].clone();
    let request_id = request["request_id"].clone();
    let conversation_id = request["conversation_id"].clone();
    let _ = start_run(request_id.clone(), conversation_id.clone());
    return Ok(Json(serde_json::to_value(process_chat(prompt, request_id, conversation_id)).map_err(|e| (
    StatusCode::INTERNAL_SERVER_ERROR,
    Json(vox_http_client::envelope::error_json("SERIALIZATION_ERROR", format!("{}", e), vox_rid.clone(), None)),
))?));
}

/// Decode the codegen-time-embedded HirModule JSON back into a runtime
/// `HirModule`. Called once from `main()` to register the process-global
