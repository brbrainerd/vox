#[derive(Embed)]
#[folder = "public/"]
struct Assets;

async fn serve_embedded(uri: axum::http::Uri) -> Response {
    let path = uri.path().trim_start_matches('/');
    let path = if path.is_empty() { "index.html" } else { path };
    match Assets::get(path) {
        Some(file) => {
            let mime = mime_guess::from_path(path).first_or_octet_stream();
            (StatusCode::OK, [(header::CONTENT_TYPE, mime.as_ref().to_string())], file.data.to_vec()).into_response()
        }
        None => {
            // SPA fallback: serve index.html for client-side routing
            match Assets::get("index.html") {
                Some(file) => (StatusCode::OK, [(header::CONTENT_TYPE, "text/html".to_string())], file.data.to_vec()).into_response(),
                None => (StatusCode::NOT_FOUND, "Not Found").into_response(),
            }
        }
    }
}

async fn serve_dispatch(req: axum::http::Request<Body>) -> Response {
    let uri = req.uri().clone();
    if *req.method() == axum::http::Method::GET {
        if let Ok(base) = std::env::var("VOX_SSR_DEV_URL") {
            let base = base.trim();
            if !base.is_empty() {
                let p = uri.path();
                if !p.starts_with("/api") {
                    let target = format!("{}{}", base.trim_end_matches('/'), uri);
                    if let Ok(client) = vox_http_client::client_builder()
                        .timeout(std::time::Duration::from_secs(60))
                        .build()
                    {
                        if let Ok(resp) = client.get(target).send().await {
                            let status = resp.status();
                            let ct = resp.headers().get(reqwest::header::CONTENT_TYPE).cloned();
                            let bytes = resp.bytes().await.unwrap_or_default();
                            let code = axum::http::StatusCode::from_u16(status.as_u16())
                                .unwrap_or(axum::http::StatusCode::BAD_GATEWAY);
                            let mut builder = Response::builder().status(code);
                            if let Some(ct) = ct {
                                if let Ok(v) = ct.to_str() {
                                    builder = builder.header(header::CONTENT_TYPE, v);
                                }
                            }
                            if let Ok(out) = builder.body(Body::from(bytes)) {
                                return out;
                            }
                        }
                    }
                }
            }
        }
    }
    serve_embedded(uri).await
}

fn vox_health_backend_kind() -> &'static str {
    let url = vox_db::resolve_app_db_url()
        .or_else(vox_db::resolve_codex_db_url);
    if let Some(url) = url {
        let u = url.to_ascii_lowercase();
        if u.starts_with("postgres://") || u.starts_with("postgresql://") {
            return "postgres";
        }
        if u.starts_with("mysql://") {
            return "mysql";
        }
    }
    "libsql"
}

async fn vox_health_probe_for_backend(backend: &str, db: &Codex) -> (StatusCode, serde_json::Value) {
    match backend {
        "libsql" => match vox_db::evaluate_codex_api_readiness(db).await {
            Ok(ready) => {
                let status = if ready.ready { StatusCode::OK } else { StatusCode::SERVICE_UNAVAILABLE };
                (status, serde_json::json!({
                    "status": if ready.ready { "ok" } else { "degraded" },
                    "backend": backend,
                    "schema_version": ready.schema_version,
                    "missing_tables": ready.missing_tables,
                    "baseline_digest": ready.baseline_digest_hex
                }))
            }
            Err(e) => (
                StatusCode::SERVICE_UNAVAILABLE,
                serde_json::json!({"status": "error", "backend": backend, "error": format!("{}", e)})
            ),
        },
        other => (
            StatusCode::SERVICE_UNAVAILABLE,
            serde_json::json!({
                "status": "degraded",
                "backend": other,
                "error": format!("generated Axum health/readiness probe does not yet include a backend-specific readiness evaluator for {}", other)
            })
        ),
    }
}

async fn handle_healthz(Extension(db): Extension<Arc<Codex>>) -> Response {
    let backend = vox_health_backend_kind();
    let (status, payload) = vox_health_probe_for_backend(backend, db.as_ref()).await;
    (status, Json(payload)).into_response()
}

async fn vox_copy_request_id(mut req: axum::http::Request<Body>, next: middleware::Next) -> Response {
    let rid = req.extensions().get::<tower_http::request_id::RequestId>().and_then(|id| id.header_value().to_str().ok().map(|s| s.to_string()));
    req.extensions_mut().insert(rid);
    next.run(req).await
}

