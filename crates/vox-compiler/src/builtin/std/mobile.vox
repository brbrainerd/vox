/// Hardware and native mobile integration.
/// Maps to the `@vox/runtime` adapter on Vox Mobile — Tauri 2 plugins (`@tauri-apps/plugin-*`) on desktop, React Native + Expo on mobile.

@mobile.native
pub fn notify(title: str, body: str) -> Result[unit] { }

@mobile.native
pub fn get_location() -> Result[str] { }

@mobile.native
pub fn vibrate() -> Result[unit] { }

@mobile.native
pub fn take_photo() -> Result[str] { }

/// On-device speech-to-text via the native `vox-tauri-stt` Tauri STT plugin (Sherpa-ONNX engine).
