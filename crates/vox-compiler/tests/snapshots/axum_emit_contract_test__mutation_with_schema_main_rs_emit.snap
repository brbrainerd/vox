// Generated by Vox Compiler
use axum::{Router, routing::{get, post}, Json};
use axum::extract::Extension;
use axum::response::{Response, IntoResponse};
use axum::body::Body;
use axum::http::{StatusCode, header};
use axum::middleware;
use axum::extract::ConnectInfo;
use tower_http::trace::TraceLayer;
use tower_http::request_id::{MakeRequestUuid, PropagateRequestIdLayer, SetRequestIdLayer};
use std::net::SocketAddr;
use rust_embed::Embed;
use std::sync::Arc;
use vox_db::Codex;
use demo::*;

#[derive(Embed)]
#[folder = "public/"]
struct Assets;

async fn serve_embedded(uri: axum::http::Uri) -> Response {
    let path = uri.path().trim_start_matches('/');
    let path = if path.is_empty() { "index.html" } else { path };
    match Assets::get(path) {
        Some(file) => {
            let mime = mime_guess::from_path(path).first_or_octet_stream();
            (StatusCode::OK, [(header::CONTENT_TYPE, mime.as_ref().to_string())], file.data.to_vec()).into_response()
        }
        None => {
            // SPA fallback: serve index.html for client-side routing
            match Assets::get("index.html") {
                Some(file) => (StatusCode::OK, [(header::CONTENT_TYPE, "text/html".to_string())], file.data.to_vec()).into_response(),
                None => (StatusCode::NOT_FOUND, "Not Found").into_response(),
            }
        }
    }
}

async fn serve_dispatch(req: axum::http::Request<Body>) -> Response {
    let uri = req.uri().clone();
    if *req.method() == axum::http::Method::GET {
        if let Ok(base) = std::env::var("VOX_SSR_DEV_URL") {
            let base = base.trim();
            if !base.is_empty() {
                let p = uri.path();
                if !p.starts_with("/api") {
                    let target = format!("{}{}", base.trim_end_matches('/'), uri);
                    if let Ok(client) = vox_http_client::client_builder()
                        .timeout(std::time::Duration::from_secs(60))
                        .build()
                    {
                        if let Ok(resp) = client.get(target).send().await {
                            let status = resp.status();
                            let ct = resp.headers().get(reqwest::header::CONTENT_TYPE).cloned();
                            let bytes = resp.bytes().await.unwrap_or_default();
                            let code = axum::http::StatusCode::from_u16(status.as_u16())
                                .unwrap_or(axum::http::StatusCode::BAD_GATEWAY);
                            let mut builder = Response::builder().status(code);
                            if let Some(ct) = ct {
                                if let Ok(v) = ct.to_str() {
                                    builder = builder.header(header::CONTENT_TYPE, v);
                                }
                            }
                            if let Ok(out) = builder.body(Body::from(bytes)) {
                                return out;
                            }
                        }
                    }
                }
            }
        }
    }
    serve_embedded(uri).await
}

fn vox_health_backend_kind() -> &'static str {
    let url = vox_db::resolve_app_db_url()
        .or_else(vox_db::resolve_codex_db_url);
    if let Some(url) = url {
        let u = url.to_ascii_lowercase();
        if u.starts_with("postgres://") || u.starts_with("postgresql://") {
            return "postgres";
        }
        if u.starts_with("mysql://") {
            return "mysql";
        }
    }
    "libsql"
}

async fn vox_health_probe_for_backend(backend: &str, db: &Codex) -> (StatusCode, serde_json::Value) {
    match backend {
        "libsql" => match vox_db::evaluate_codex_api_readiness(db).await {
            Ok(ready) => {
                let status = if ready.ready { StatusCode::OK } else { StatusCode::SERVICE_UNAVAILABLE };
                (status, serde_json::json!({
                    "status": if ready.ready { "ok" } else { "degraded" },
                    "backend": backend,
                    "schema_version": ready.schema_version,
                    "missing_tables": ready.missing_tables,
                    "baseline_digest": ready.baseline_digest_hex
                }))
            }
            Err(e) => (
                StatusCode::SERVICE_UNAVAILABLE,
                serde_json::json!({"status": "error", "backend": backend, "error": format!("{}", e)})
            ),
        },
        other => (
            StatusCode::SERVICE_UNAVAILABLE,
            serde_json::json!({
                "status": "degraded",
                "backend": other,
                "error": format!("generated Axum health/readiness probe does not yet include a backend-specific readiness evaluator for {}", other)
            })
        ),
    }
}

async fn handle_healthz(Extension(db): Extension<Arc<Codex>>) -> Response {
    let backend = vox_health_backend_kind();
    let (status, payload) = vox_health_probe_for_backend(backend, db.as_ref()).await;
    (status, Json(payload)).into_response()
}

async fn vox_copy_request_id(mut req: axum::http::Request<Body>, next: middleware::Next) -> Response {
    let rid = req.extensions().get::<tower_http::request_id::RequestId>().and_then(|id| id.header_value().to_str().ok().map(|s| s.to_string()));
    req.extensions_mut().insert(rid);
    next.run(req).await
}

#[tokio::main]
async fn main() {
    tracing_subscriber::fmt::init();
    // ── Database setup (Codex / vox_db) ──
    // Guard rail: app-plane DB URL may target non-libsql in this phase.
    // Keep Codex setup for table runtime and emit a warning instead of hard-failing.
    if let Some(app_url) = vox_db::resolve_app_db_url() {
        let u = app_url.to_ascii_lowercase();
        if u.starts_with("postgres://") || u.starts_with("postgresql://") || u.starts_with("mysql://") {
            eprintln!("VOX_APP_DB_URL uses non-libsql backend ({}) — generated Axum table runtime still boots Codex while backend-specific table dispatch is completed incrementally", app_url);
        }
    }
    let cfg = match vox_db::DbConfig::resolve_canonical() {
        Ok(cfg) => cfg,
        Err(e) => {
            eprintln!("Failed to resolve Codex DB config (VOX_DB_URL+TOKEN, or VOX_DB_PATH): {}", e);
            std::process::exit(2);
        }
    };
    let codex = match vox_db::Codex::connect(cfg).await {
        Ok(db) => db,
        Err(e) => {
            eprintln!("Failed to open Codex database: {}", e);
            std::process::exit(2);
        }
    };
    {
        let mut __vox_jm = match codex.connection().query("PRAGMA journal_mode=WAL;", ()).await {
            Ok(rows) => rows,
            Err(e) => {
                eprintln!("PRAGMA journal_mode failed: {}", e);
                std::process::exit(2);
            }
        };
        loop {
            match __vox_jm.next().await {
                Ok(Some(_)) => {}
                Ok(None) => break,
                Err(e) => {
                    eprintln!("PRAGMA journal_mode row iteration failed: {}", e);
                    std::process::exit(2);
                }
            }
        }
    }
    if let Err(e) = codex.connection().execute_batch("PRAGMA foreign_keys=ON;").await {
        eprintln!("PRAGMA foreign_keys failed: {}", e);
        std::process::exit(2);
    }
    if let Err(e) = codex.connection().execute_batch(r#"
CREATE TABLE IF NOT EXISTS t (
_id INTEGER PRIMARY KEY AUTOINCREMENT,
    a TEXT NOT NULL
);
"#).await {
        eprintln!("schema migration failed: {}", e);
        std::process::exit(2);
    }
    // Boot-time schema drift validation (table/column/type parity).
    {
        let __vox_norm_sql_ty = |s: &str| {
            s.to_ascii_lowercase()
                .replace(' ', "")
                .replace("(1)", "")
                .replace("(65,30)", "")
        };
        let mut __vox_cols_0: std::collections::BTreeMap<String, String> = std::collections::BTreeMap::new();
        let mut __vox_seen_rows_0 = false;
        let mut __vox_rows_0 = match codex.connection().query("PRAGMA table_info('t');", ()).await {
            Ok(rows) => rows,
            Err(e) => {
                eprintln!("schema drift: failed to inspect table 't': {}", e);
                std::process::exit(2);
            }
        };
        loop {
            match __vox_rows_0.next().await {
                Ok(Some(__vox_row)) => {
                    __vox_seen_rows_0 = true;
                    let __vox_col_name: String = match __vox_row.get(1) {
                        Ok(v) => v,
                        Err(e) => {
                            eprintln!("schema drift: failed reading column name for table 't': {}", e);
                            std::process::exit(2);
                        }
                    };
                    let __vox_col_ty: String = match __vox_row.get(2) {
                        Ok(v) => v,
                        Err(e) => {
                            eprintln!("schema drift: failed reading column type for table 't': {}", e);
                            std::process::exit(2);
                        }
                    };
                    __vox_cols_0.insert(__vox_col_name.to_ascii_lowercase(), __vox_col_ty);
                }
                Ok(None) => break,
                Err(e) => {
                    eprintln!("schema drift: failed iterating columns for table 't': {}", e);
                    std::process::exit(2);
                }
            }
        }
        if !__vox_seen_rows_0 {
            eprintln!("schema drift: live table 't' is missing");
            std::process::exit(2);
        }
        match __vox_cols_0.get("a") {
            Some(__vox_live_ty) => {
                if __vox_norm_sql_ty(__vox_live_ty) != __vox_norm_sql_ty("TEXT") {
                    eprintln!("schema drift: table 't' column 'a' type mismatch (expected TEXT, got {})", __vox_live_ty);
                    std::process::exit(2);
                }
            }
            None => {
                eprintln!("schema drift: table 't' missing required column 'a'");
                std::process::exit(2);
            }
        }
    }
    let db = Arc::new(codex);

    // 1. Initialize the durable database.
    //    Uses `DbConfig::resolve_canonical()` so the binary picks up
    //    `VOX_DB_URL`/`VOX_DB_PATH` env vars (matches `emit_db_setup`).
    let vox_durable_db = std::sync::Arc::new(::vox_db::VoxDb::connect(
        ::vox_db::DbConfig::resolve_canonical()
            .expect("vox durable boot: resolve VoxDb config (VOX_DB_URL+TOKEN, or VOX_DB_PATH)"),
    ).await.expect("vox durable boot: VoxDb::connect"));

    // 2. Register the process-global HirModule for workflow body lookup.
    //    The HirModule is serialized to JSON at codegen time and embedded
    //    as a `const &str` (see `load_hir_module_from_embedded` below).
    ::vox_workflow_runtime::workflow::set_current_hir_module(
        load_hir_module_from_embedded()
    );

    // 3. No `@scheduled` functions in this module — scheduler not started.

    let mut app = Router::new()
        .route("/healthz", get(handle_healthz))
        .route("/readyz", get(handle_healthz))
        .route("/api/mutation/m_save", post(handle_m_m_save))
        .fallback(serve_dispatch);

    app = app.layer(Extension(db.clone()));
    app = app.layer(middleware::from_fn(vox_copy_request_id));
    app = app.layer(PropagateRequestIdLayer::x_request_id());
    app = app.layer(SetRequestIdLayer::x_request_id(MakeRequestUuid));
    app = app.layer(TraceLayer::new_for_http());

    let port: u16 = std::env::var("VOX_PORT")
        .ok()
        .and_then(|s| s.parse().ok())
        .unwrap_or(3000);
    let addr = SocketAddr::from(([127, 0, 0, 1], port));
    println!("Listening on {}", addr);
    let listener = match tokio::net::TcpListener::bind(addr).await {
        Ok(listener) => listener,
        Err(e) => { eprintln!("Failed to bind TCP listener: {}", e); std::process::exit(2); }
    };
    if let Err(e) = axum::serve(listener, app.into_make_service_with_connect_info::<SocketAddr>()).await {
        eprintln!("Server exited with error: {}", e);
        std::process::exit(2);
    }
    vox_actor_runtime::builtins::vox_flush_exit_commands();
}

async fn handle_m_m_save(Extension(vox_rid): Extension<Option<String>>, Extension(db): Extension<Arc<Codex>>, Json(request): Json<serde_json::Value>) -> Result<Json<serde_json::Value>, (StatusCode, Json<serde_json::Value>)> {
    let db = (*db).clone();
    match db.transaction(async move {
        return Ok(Json(serde_json::to_value(1).map_err(|e| vox_db::StoreError::Serialization(format!("{}", e)))?));
    }).await {
        Ok(resp) => Ok(resp),
        Err(e) => Err((StatusCode::INTERNAL_SERVER_ERROR, Json(vox_http_client::envelope::error_json("INTERNAL_ERROR", e.to_string(), vox_rid.clone(), None)))),
    }
}

/// Decode the codegen-time-embedded HirModule JSON back into a runtime
/// `HirModule`. Called once from `main()` to register the process-global
/// module for `current_hir_module()` lookups (ADR-041 §6(b)).
fn load_hir_module_from_embedded() -> ::vox_compiler::hir::HirModule {
    const EMBEDDED_HIR: &str = r#"{"imports":[],"rust_imports":[],"functions":[],"types":[],"tests":[],"examples":[],"foralls":[],"endpoint_fns":[{"kind":"Mutation","id":1,"name":"m_save","params":[],"return_type":{"Named":"int"},"body":[{"Return":{"value":{"IntLit":[1,{"start":69,"end":70}]},"span":{"start":62,"end":71}}}],"route_path":"/api/mutation/m_save","is_pure":false,"webhook":null,"cors":null,"rate_limit":null,"pii":null,"layer":null,"span":{"start":37,"end":73}}],"tables":[{"id":0,"name":"T","fields":[{"name":"a","type_ann":{"Named":"str"},"span":{"start":17,"end":25}}],"is_extern":false,"is_pub":false,"is_deprecated":false,"span":{"start":1,"end":26}}],"indexes":[],"collections":[],"vector_indexes":[],"search_indexes":[],"mcp_tools":[],"mcp_resources":[],"agents":[],"environments":[],"components":[],"client_routes":[],"url_decls":[],"state_machines":[],"fragments":[],"reactive_modules":[],"forms":[],"back_button":null,"deep_link":null,"push":null,"token_decls":[],"route_ids":[],"inferred_types":{},"consts":[],"configs":[],"themes":[],"messages":[],"skills":[],"agent_defs":[],"legacy_ast_nodes":[]}"#;
    ::serde_json::from_str(EMBEDDED_HIR)
        .expect("embedded HirModule deserializes (codegen wrote it; should round-trip)")
}
