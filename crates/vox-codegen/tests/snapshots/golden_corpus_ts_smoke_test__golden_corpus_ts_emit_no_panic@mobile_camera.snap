import React, { useState } from "react";

export interface PhotoUploaderProps {
  on_image: any;
}

export function PhotoUploader({ on_image }: PhotoUploaderProps): React.ReactElement {
  const [status, set_status] = useState("idle");
  const [last_photo, set_last_photo] = useState(None);
  return (
    <div className="px-4">
    <div className={["flex", "flex-col", "uploader"].filter(Boolean).join(" ")}>
      <p className={["text-base", "status"].filter(Boolean).join(" ")}>
        {"Status: "}
      </p>
      <p className={"text-base"}>
        {status}
      </p>
      <button className={["inline-flex", "items-center", "justify-center", "rounded-md", "text-sm", "font-medium", "ring-offset-background", "transition-colors", "focus-visible:outline-none", "focus-visible:ring-2", "focus-visible:ring-ring", "focus-visible:ring-offset-2", "disabled:pointer-events-none", "disabled:opacity-50", "bg-primary", "text-primary-foreground", "hover:bg-primary/90", "h-10", "px-4", "py-2"].filter(Boolean).join(" ")} onClick={(() => ((() => {
        set_status("capturing");
        (((_val) => { switch((_val as any)._tag) { case "Ok": { const uri = (_val as any)._p0 ?? (_val as any).value; return (() => {
        set_last_photo(Some(uri));
        set_status("done");
        on_image(uri);
      })(); } case "Error": { const msg = (_val as any)._p0 ?? (_val as any).value; return (() => {
        set_status("error: " + msg);
        mobile.notify("Camera Error", msg);
      })(); } default: return undefined; } })(mobile.take_photo()));
      })()))}>
        {"Take Photo"}
      </button>
      <button className={["inline-flex", "items-center", "justify-center", "rounded-md", "text-sm", "font-medium", "ring-offset-background", "transition-colors", "focus-visible:outline-none", "focus-visible:ring-2", "focus-visible:ring-ring", "focus-visible:ring-offset-2", "disabled:pointer-events-none", "disabled:opacity-50", "bg-primary", "text-primary-foreground", "hover:bg-primary/90", "h-10", "px-4", "py-2"].filter(Boolean).join(" ")} onClick={(() => (mobile.vibrate()))}>
        {"Vibrate"}
      </button>
      {(((_val) => { switch((_val as any)._tag) { case "Some": { const uri = (_val as any)._p0 ?? (_val as any).value; return <img className={["max-w-full", "h-auto"].filter(Boolean).join(" ")} src={uri} alt={"captured"} />; } case "None": {  return <div className={["flex", "flex-col", "placeholder"].filter(Boolean).join(" ")}
    >
      {"No photo captured"}
    </div>; } default: return undefined; } })(last_photo))}
    </div>
    </div>
  );
}


