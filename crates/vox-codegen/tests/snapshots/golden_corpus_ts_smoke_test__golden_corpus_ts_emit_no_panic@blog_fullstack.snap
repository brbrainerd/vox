// Generated by Vox. Typed routes (GA-09a). Do not edit.

export type RouteId =
  | { _route: "BlogHome" }
  | { _route: "PostEditor" }
;

export const Route = {
  BlogHome: (): RouteId => ({ _route: "BlogHome" }),
  PostEditor: (): RouteId => ({ _route: "PostEditor" }),
} as const;

export function hrefOf(r: RouteId): string {
  switch (r._route) {
    case "BlogHome": return "/";
    case "PostEditor": return "/edit";
  }
}

export function analyticsSlugOf(r: RouteId): string {
  switch (r._route) {
    case "BlogHome": return "blog_home";
    case "PostEditor": return "post_editor";
  }
}
