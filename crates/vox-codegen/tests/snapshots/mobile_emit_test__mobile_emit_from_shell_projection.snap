// AUTO-GENERATED by Vox mobile_emit. Target-agnostic: every call goes through
// the `@vox/runtime` adapter contract so the same source runs on desktop (Tauri)
// and mobile (React Native + Expo) without per-platform branches.
//
// Capability-driven Android/iOS manifest hints share SSOT:
// contracts/capability/runtime-capabilities.v1.yaml → runtime-capabilities.projection.json
// (emitted beside Tauri packaging hints on `vox compile` when contracts root is found).
//
import * as endpoints from './vox-client';
import { voxRuntime } from '@vox/runtime';

let __backHandlerUnsubscribe: (() => void) | undefined;
export function installBackButtonHandler() {
  if (__backHandlerUnsubscribe) return;
  __backHandlerUnsubscribe = voxRuntime.onBackButton(async () => {
    const handled = await endpoints.handle_back();
    if (handled) return true;
    return false;
  });
}
export function uninstallBackButtonHandler() {
  __backHandlerUnsubscribe?.();
  __backHandlerUnsubscribe = undefined;
}

import { useEffect } from 'react';

export function useDeepLinkRouting(navigate: (opts: { to: string }) => void) {
  useEffect(() => {
    const unsubscribe = voxRuntime.onDeepLink(async (url) => {
      const target = await endpoints.handle_link(url);
      if (target) {
        navigate({ to: target });
        return target;
      }
      return null;
    });
    return () => { unsubscribe(); };
  }, [navigate]);
}

export async function installPushNotifications() {
  await voxRuntime.installPushNotifications(
  {
    onRegister: async (token) => { await endpoints.store_token(token); }
  }
  );
}
