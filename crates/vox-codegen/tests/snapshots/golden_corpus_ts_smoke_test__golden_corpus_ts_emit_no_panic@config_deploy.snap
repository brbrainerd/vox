export type DatabaseConfig =
  | { readonly _tag: "DatabaseConfig"; readonly url: string; readonly pool_size: number };

export const DatabaseConfig = (url: string, pool_size: number): DatabaseConfig => ({ _tag: "DatabaseConfig", url, pool_size });



