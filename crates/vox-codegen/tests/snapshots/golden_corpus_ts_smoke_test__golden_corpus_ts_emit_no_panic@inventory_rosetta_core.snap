=== types.ts ===
export type MergeError =
  | { readonly _tag: "WrongKind"; readonly left: string; readonly right: string }
  | { readonly _tag: "InvalidCap"; readonly cap: number };

export const WrongKind = (left: string, right: string): MergeError => ({ _tag: "WrongKind", left, right });
export const InvalidCap = (cap: number): MergeError => ({ _tag: "InvalidCap", cap });

export type MergeOutcome =
  | { readonly _tag: "Applied"; readonly primary: number; readonly overflow: number }
  | { readonly _tag: "Rejected"; readonly err: MergeError };

export const Applied = (primary: number, overflow: number): MergeOutcome => ({ _tag: "Applied", primary, overflow });
export const Rejected = (err: MergeError): MergeOutcome => ({ _tag: "Rejected", err });



