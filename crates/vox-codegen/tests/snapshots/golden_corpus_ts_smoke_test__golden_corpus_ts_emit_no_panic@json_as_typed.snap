=== types.ts ===
export type Product = { readonly id: number; readonly name: string; readonly price: number; readonly description: string };

export type ApiEvent = { readonly event_type: string; readonly created_at: string; readonly payload_size: number };

export type Order = { readonly id: string; readonly count: number };

export type Config = { readonly host: string; readonly port: number; readonly retries: number };

export type ToolCall =
  | { readonly _tag: "Search"; readonly query: string }
  | { readonly _tag: "Fetch"; readonly url: string };

export const Search = (query: string): ToolCall => ({ _tag: "Search", query });
export const Fetch = (url: string): ToolCall => ({ _tag: "Fetch", url });

export type Shape =
  | { readonly _tag: "Circle"; readonly radius: number }
  | { readonly _tag: "Square"; readonly side: number };

export const Circle = (radius: number): Shape => ({ _tag: "Circle", radius });
export const Square = (side: number): Shape => ({ _tag: "Square", side });



