=== types.ts ===
export type Shape =
  | { readonly _tag: "Circle"; readonly radius: number }
  | { readonly _tag: "Rectangle"; readonly w: number; readonly h: number }
  | { readonly _tag: "Point" };

export const Circle = (radius: number): Shape => ({ _tag: "Circle", radius });
export const Rectangle = (w: number, h: number): Shape => ({ _tag: "Rectangle", w, h });
export const Point: Shape = { _tag: "Point" };



