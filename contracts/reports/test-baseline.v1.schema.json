{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestBaseline",
  "description": "Output of scripts/perf/test-baseline.vox",
  "type": "object",
  "required": ["schema_version", "generated_at", "env", "tiers"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "description": "ISO-8601 UTC timestamp" },
    "env": {
      "type": "object",
      "required": ["cpu_logical_threads", "ram_gb", "target_dir_gb", "cargo_version", "nextest_version", "llvm_cov_version"],
      "properties": {
        "cpu_logical_threads": { "type": "integer" },
        "ram_gb": { "type": "number" },
        "target_dir_gb": { "type": "number" },
        "cargo_version": { "type": "string" },
        "nextest_version": { "type": "string" },
        "llvm_cov_version": { "type": "string" }
      }
    },
    "tiers": {
      "type": "object",
      "description": "Keyed by tier name: fast, complete, full, full_cov",
      "additionalProperties": {
        "type": "object",
        "required": ["wall_ms", "steps"],
        "properties": {
          "wall_ms": { "type": "integer", "description": "Total wall-clock milliseconds" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "wall_ms", "ok"],
              "properties": {
                "label": { "type": "string" },
                "wall_ms": { "type": "integer" },
                "ok": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "top_slow_tests": {
      "type": "array",
      "description": "Top-20 slowest tests from the full run (populated when nextest run completes)",
      "items": {
        "type": "object",
        "required": ["crate", "test", "wall_ms"],
        "properties": {
          "crate": { "type": "string" },
          "test": { "type": "string" },
          "wall_ms": { "type": "integer" }
        }
      }
    }
  }
}
