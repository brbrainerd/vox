{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/reports/pre-push-report.v1.schema.json",
  "title": "pre-push-report-v1",
  "description": "Structured timing output from `vox ci pre-push --report-json`. schema_version 2 adds `profile` and `complete`; schema_version 3 adds `with_coverage` and new profile values (`full+cov`, `full+since`, `full+cov+since`); schema_version 4 adds optional per-step `scope` metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "ok",
    "quick",
    "complete",
    "full",
    "with_coverage",
    "dry_run",
    "total_ms",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2, 3, 4]
    },
    "profile": {
      "type": "string",
      "enum": ["fast", "complete", "full", "full+cov", "full+since", "full+cov+since"]
    },
    "ok": {
      "type": "boolean"
    },
    "quick": {
      "type": "boolean"
    },
    "complete": {
      "type": "boolean"
    },
    "full": {
      "type": "boolean"
    },
    "with_coverage": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "total_ms": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "elapsed_ms"],
        "properties": {
          "label": {
            "type": "string"
          },
          "elapsed_ms": {
            "anyOf": [
              { "type": "integer", "minimum": 0 },
              { "type": "null" }
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "impacted_packages": { "type": "integer", "minimum": 0 },
              "chunk_count": { "type": "integer", "minimum": 0 },
              "fallback_reason": { "type": "string" },
              "toestub_roots": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
