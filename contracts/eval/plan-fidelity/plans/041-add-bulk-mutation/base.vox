// Base source for plan-041-add-bulk-mutation.
//
// Existing single mutation. The plan asks the model to add a
// `delete_all() to Result[int, FooError]` bulk sibling.

type FooError =
    | NotFound(text: str)

@endpoint(kind: mutation)
fn delete_one(id: str) to Result[str, FooError] {
    if len(id) is 0 {
        return Error(NotFound("id must not be empty"))
    }
    return Ok(id)
}

@test
fn test_delete_one_rejects_empty() to Unit {
    let r = delete_one("")
    match r {
        Error(NotFound(_)) => assert(true)
        Ok(_)              => assert(false)
    }
}
