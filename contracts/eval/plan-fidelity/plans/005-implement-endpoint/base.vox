// Base source for plan-005-implement-endpoint.
//
// Skeleton of the marquee todo-auth project. The plan asks the model
// to ADD an `archive_todo` @endpoint that validates the id length and
// returns Result[str, TodoError], plus a @test exercising the empty-
// id error path via the existing TodoError ADT.

type TodoError =
    | TitleEmpty(text: str)
    | TitleTooLong(text: str)
    | EmptyId(text: str)

@endpoint(kind: mutation) @auth(scheme: bearer)
fn add_todo(title: str) to Result[str, TodoError] {
    if len(title) is 0 {
        return Error(TitleEmpty("title must not be empty"))
    }
    return Ok("queued")
}

@test
fn test_add_todo_empty_returns_error() to Unit {
    let result = add_todo("")
    match result {
        Error(TitleEmpty(_))   => assert(true)
        Error(TitleTooLong(_)) => assert(false)
        Error(EmptyId(_))      => assert(false)
        Ok(_)                  => assert(false)
    }
}
