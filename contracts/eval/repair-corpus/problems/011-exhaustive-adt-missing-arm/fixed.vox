// Fix: add the Connected arm with its address and port bindings.
type NetworkState =
    | Disconnected
    | Connecting
    | Connected(address: str, port: int)

fn status_label(state: NetworkState) to str {
    match state {
        Disconnected => "offline"
        Connecting => "connecting..."
        Connected(address, port) => "connected to " + address + ":" + str(port)
    }
}
