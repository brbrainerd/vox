// Bug: range starts at 0 instead of 1 — produces ["FizzBuzz", "1", "2", ...]
// instead of ["1", "2", "Fizz", ...] because 0 % 15 == 0 fires first
// and the loop misses the value n.
fn fizzbuzz(n: int) to list[str] {
    let mut result: list[str] = []
    for i in range(0, n) {      // BUG: range(0, n) gives 0..n-1; should be range(1, n+1)
        if i % 15 == 0 {
            result.push("FizzBuzz")
        } else {
            if i % 3 == 0 {
                result.push("Fizz")
            } else {
                if i % 5 == 0 {
                    result.push("Buzz")
                } else {
                    result.push(str(i))
                }
            }
        }
    }
    return result
}

fn main() to str {
    assert(fizzbuzz(3) == ["1", "2", "Fizz"])
    assert(fizzbuzz(5) == ["1", "2", "Fizz", "4", "Buzz"])
    assert(fizzbuzz(15) == ["1", "2", "Fizz", "4", "Buzz", "Fizz", "7", "8", "Fizz", "Buzz", "11", "Fizz", "13", "14", "FizzBuzz"])
    return "ok"
}
