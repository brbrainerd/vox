// Repair-corpus fixture 046 — api-misuse bug class.
// `double` takes int but the caller passes Option[int] directly,
// skipping the required unwrap/match step. Expected repair: match
// the Option to pull the int out before calling, e.g.
// `match maybe { Some(n) => double(n), None => 0 }`.

fn double(n: int) to int {
    return n * 2
}

fn caller(maybe: Option[int]) to int {
    return double(maybe)
}
