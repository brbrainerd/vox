// Repair-corpus fixture 002 — effect-violation bug class.
// @pure fn classify calls env.println which requires the `env` capability.
// Expected repair: drop @pure and declare `uses env`, or remove the env.println call.

@pure
fn classify(n: int) to str {
    env.println(as_string(n))
    if n is 0 {
        return "zero"
    }
    return "nonzero"
}
