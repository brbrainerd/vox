# Node
**/node_modules/
**/out/
node_modules/
dist/
dist1/
docs-astro/src/content/docs
# setup-content.mjs also symlinks this one from repo-root examples/, but a
# real 200-file copy was committed here at some point and has since drifted
# from the source of truth (13 files differ; the real examples/ tree was
# last touched 2026-08-30, this copy's last real edit was 2026-08-22). Once
# untracked, the symlink takes over and docs render the current examples.
docs-astro/src/examples
docs-astro/public/assets
docs-astro/public/.well-known
.env

# Local TOESTUB / audit outputs (do not commit large JSON baselines)
/artifacts/
.tmp_audit/
# Compiled plugin binaries produced by full-runtime audit runs (build artifacts)
/.vox/audit/**/vox_plugin_*.dll
/.vox/audit/**/vox_plugin_*.so
/.vox/audit/**/vox_plugin_*.dylib

# CR-L8 corpus-feedback per-run events (P2.1c, ratified 2026-05-15).
# Per-day JSONL files written by `CorpusFeedbackJsonlSink` are measurement
# noise — not source-of-truth. The substantive quarterly report at
# contracts/reports/corpus-feedback/<quarter>.json IS the gated v1.0
# artifact and remains committed. See
# docs/src/architecture/v1-llm-target-implementation-plan-2026.md §1.3 P2.1c.
/contracts/reports/corpus-feedback-events/

# LLM-panel response cache (CR-L0/L1/L3/L4 panel runners). Content-addressed
# disk cache written by CachingPanelClient; regenerated on demand. The
# canonical evidence is the per-gate <UTC>.json artifact, not the cache.
# Per honest-completion-plan §3.x.
/contracts/reports/llm-panel-cache/

# GUI visual AI review — per-run dated JSON reports are CI upload artifacts only.
# Committed SSOT: cache.v1.json (+ ledger.jsonl when present). See docs/src/architecture/gui-visual-ai-review.md.
/contracts/reports/gui-visual-review/*.json
!/contracts/reports/gui-visual-review/cache.v1.json
!/contracts/reports/gui-visual-review/bundle-cache.v1.json

# Playwright HTML report (local e2e runs; never commit)
**/playwright-report/

# === SCRATCH / EPHEMERAL / LOGS ===
.tmp_metadata.json
scratch/*
!scratch/.gitkeep
test_output*.txt
bundle_*.txt
*.log


